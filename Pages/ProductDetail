import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent } from "@/components/ui/card";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { motion } from "framer-motion";
import {
  ShoppingCart,
  Truck,
  User,
  CheckCircle2,
  ArrowRight
} from "lucide-react";
import { useCart } from "../components/cart/useCart";

export default function ProductDetail() {
  const navigate = useNavigate();
  const [productId, setProductId] = React.useState(null);
  const [selectedSize, setSelectedSize] = React.useState("");
  const [selectedMaterial, setSelectedMaterial] = React.useState("");
  const [quantity, setQuantity] = React.useState(1);
  const [showSuccess, setShowSuccess] = React.useState(false);
  const { addToCart } = useCart();

  React.useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    setProductId(params.get("id"));
  }, []);

  const { data: product, isLoading } = useQuery({
    queryKey: ['productListing', productId],
    queryFn: async () => {
      const listings = await base44.entities.ProductListing.filter({ id: productId });
      return listings[0];
    },
    enabled: !!productId,
  });

  const handleAddToCart = () => {
    if (!selectedSize || !selectedMaterial) {
      alert("Please select size and material");
      return;
    }

    addToCart({
      id: product.id,
      product_listing_id: product.id,
      design_id: product.design_id,
      product_name: product.product_name,
      description: product.description,
      price: product.price,
      image_url: product.thumbnail_url,
      selectedSize,
      selectedMaterial,
      quantity,
      seller_name: product.seller_name,
      seller_email: product.seller_email
    });

    setShowSuccess(true);
    setTimeout(() => setShowSuccess(false), 3000);
  };

  if (isLoading || !product) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 p-4 md:p-8">
      <div className="max-w-6xl mx-auto">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* Product Preview */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
          >
            <Card className="overflow-hidden">
              <div className="h-96 bg-gray-100 flex items-center justify-center text-9xl">
                👕
              </div>
            </Card>
          </motion.div>

          {/* Product Details */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            className="space-y-6"
          >
            <div>
              <h1 className="text-3xl font-bold text-gray-900 mb-2">
                {product.product_name}
              </h1>
              <div className="flex items-center gap-4 text-sm text-gray-600 mb-4">
                <span className="flex items-center gap-1">
                  <User className="w-4 h-4" />
                  {product.seller_name || product.seller_email.split('@')[0]}
                </span>
                <span>{product.sales_count || 0} sold</span>
              </div>
              <div className="text-4xl font-bold text-purple-600 mb-4">
                ${product.price.toFixed(2)}
              </div>
              <p className="text-gray-700">{product.description}</p>
            </div>

            {/* Options */}
            <div className="space-y-4">
              <div>
                <Label>Size</Label>
                <div className="grid grid-cols-3 gap-2 mt-2">
                  {product.available_sizes?.map(size => (
                    <Button
                      key={size}
                      variant={selectedSize === size ? "default" : "outline"}
                      onClick={() => setSelectedSize(size)}
                      className={selectedSize === size ? "bg-purple-500" : ""}
                    >
                      {size}
                    </Button>
                  ))}
                </div>
              </div>

              <div>
                <Label>Material</Label>
                <Select value={selectedMaterial} onValueChange={setSelectedMaterial}>
                  <SelectTrigger className="mt-2">
                    <SelectValue placeholder="Select material" />
                  </SelectTrigger>
                  <SelectContent>
                    {product.available_materials?.map(material => (
                      <SelectItem key={material} value={material}>
                        {material.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <Label>Quantity</Label>
                <Input
                  type="number"
                  min="1"
                  max="10"
                  value={quantity}
                  onChange={(e) => setQuantity(parseInt(e.target.value) || 1)}
                  className="mt-2"
                />
              </div>
            </div>

            {/* Add to Cart Button */}
            <div className="space-y-3">
              <Button
                onClick={handleAddToCart}
                disabled={!selectedSize || !selectedMaterial}
                className="w-full bg-gradient-to-r from-purple-500 to-pink-500 text-lg py-6"
              >
                <ShoppingCart className="w-5 h-5 mr-2" />
                Add to Cart - ${(product.price * quantity).toFixed(2)}
              </Button>

              {showSuccess && (
                <motion.div
                  initial={{ opacity: 0, y: -10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center gap-2"
                >
                  <CheckCircle2 className="w-5 h-5 text-green-600" />
                  <span className="text-sm text-green-700 font-medium">Added to cart!</span>
                  <Button
                    size="sm"
                    variant="link"
                    onClick={() => navigate(createPageUrl("Cart"))}
                    className="ml-auto text-green-700"
                  >
                    View Cart <ArrowRight className="w-3 h-3 ml-1" />
                  </Button>
                </motion.div>
              )}
            </div>

            {/* Shipping Info */}
            <Card className="bg-blue-50 border-blue-200">
              <CardContent className="p-4 flex items-start gap-3">
                <Truck className="w-5 h-5 text-blue-600 mt-1" />
                <div>
                  <p className="font-semibold text-gray-900 mb-1">Print & Ship Service</p>
                  <p className="text-sm text-gray-600">
                    Your custom design will be professionally printed and shipped within 7-10 business days.
                  </p>
                </div>
              </CardContent>
            </Card>
          </motion.div>
        </div>
      </div>
    </div>
  );
}
