import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery, useMutation } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { motion } from "framer-motion";
import {
  Sparkles,
  Loader2,
  Upload,
  Palette,
  Shirt,
  Lightbulb
} from "lucide-react";
import { Badge } from "@/components/ui/badge";
import ProductSuggestions from "../components/recommendations/ProductSuggestions";

export default function AIRecommendations() {
  const navigate = useNavigate();
  const [user, setUser] = React.useState(null);
  const [preferences, setPreferences] = React.useState("");
  const [uploadedImage, setUploadedImage] = React.useState(null);
  const [recommendations, setRecommendations] = React.useState(null);
  const [isGenerating, setIsGenerating] = React.useState(false);
  const fileInputRef = React.useRef(null);

  React.useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await base44.auth.me();
        setUser(currentUser);
      } catch (error) {
        base44.auth.redirectToLogin(createPageUrl("AIRecommendations"));
      }
    };
    loadUser();
  }, []);

  const { data: userDesigns = [] } = useQuery({
    queryKey: ['userDesigns', user?.email],
    queryFn: () => base44.entities.CustomDesign.filter({ user_email: user.email }, '-created_date'),
    enabled: !!user?.email,
    initialData: [],
  });

  const { data: userProfile } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0];
    },
    enabled: !!user?.email,
  });

  const handleImageUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const { file_url } = await base44.integrations.Core.UploadFile({ file });
      setUploadedImage(file_url);
    } catch (error) {
      console.error("Error uploading image:", error);
    }
  };

  const generateRecommendations = async () => {
    setIsGenerating(true);
    try {
      // Analyze past designs with detailed metrics
      const designSummary = userDesigns.slice(0, 10).map(d => ({
        garment: d.garment_type,
        material: d.material,
        color: d.base_color,
        graphics_count: d.graphics?.length || 0,
        created_date: d.created_date
      }));

      // Calculate user preferences from history
      const colorFrequency = {};
      const materialFrequency = {};
      const garmentFrequency = {};
      
      userDesigns.forEach(d => {
        colorFrequency[d.base_color] = (colorFrequency[d.base_color] || 0) + 1;
        materialFrequency[d.material] = (materialFrequency[d.material] || 0) + 1;
        garmentFrequency[d.garment_type] = (garmentFrequency[d.garment_type] || 0) + 1;
      });

      const favoriteColors = Object.entries(colorFrequency)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 3)
        .map(([color]) => color);

      const prompt = `As a fashion design AI expert, analyze this user's design history and preferences to provide personalized recommendations:

**User's Design History (Last ${userDesigns.length} designs):**
${JSON.stringify(designSummary)}

**User's Preferences:**
- Favorite Colors: ${favoriteColors.join(', ') || 'Not enough data'}
- Most Used Material: ${Object.entries(materialFrequency).sort((a, b) => b[1] - a[1])[0]?.[0] || 'None'}
- Most Created Garment: ${Object.entries(garmentFrequency).sort((a, b) => b[1] - a[1])[0]?.[0] || 'None'}
- Style Profile: ${userProfile?.style_preferences?.join(', ') || 'Not specified'}
- Additional Notes: ${preferences || "None"}
${uploadedImage ? "- User has uploaded an inspiration image" : ""}

Provide HIGHLY PERSONALIZED recommendations:
1. **Recommended Color Palettes** (4-5 colors with hex codes that complement their style)
2. **Next Design Ideas** (Specific garment + style combinations based on their history)
3. **Graphics & Patterns** (Suggest complementary design elements)
4. **Material Upgrades** (Better materials for their preferred garments)
5. **Style Evolution** (How to expand their design style naturally)
6. **Trending Elements** (Current trends that match their aesthetic)

Format as JSON with clear sections and specific hex codes for colors.`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt: prompt,
        add_context_from_internet: true,
        file_urls: uploadedImage ? [uploadedImage] : null,
        response_json_schema: {
          type: "object",
          properties: {
            color_palettes: {
              type: "array",
              items: {
                type: "object",
                properties: {
                  name: { type: "string" },
                  colors: { type: "array", items: { type: "string" } },
                  description: { type: "string" }
                }
              }
            },
            next_designs: { type: "array", items: { type: "string" } },
            graphics_patterns: { type: "array", items: { type: "string" } },
            material_upgrades: { type: "array", items: { type: "string" } },
            style_evolution: { type: "string" },
            trending_elements: { type: "array", items: { type: "string" } }
          }
        }
      });

      setRecommendations(result);
    } catch (error) {
      console.error("Error generating recommendations:", error);
    }
    setIsGenerating(false);
  };

  if (!user) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 p-4 md:p-8">
      <div className="max-w-5xl mx-auto">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <div className="flex items-center gap-3 mb-4">
            <div className="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
              <Sparkles className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-3xl font-bold text-gray-900">AI Style Recommendations</h1>
              <p className="text-gray-600">Get personalized design suggestions powered by AI</p>
            </div>
          </div>
        </motion.div>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {/* Input Section */}
          <div className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Lightbulb className="w-5 h-5 text-yellow-500" />
                  Tell Us Your Preferences
                </CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div>
                  <Label>What style are you going for?</Label>
                  <Textarea
                    placeholder="E.g., Minimalist streetwear, vintage 90s, bold and colorful, nature-inspired..."
                    value={preferences}
                    onChange={(e) => setPreferences(e.target.value)}
                    className="mt-2 min-h-32"
                  />
                </div>

                <div>
                  <Label>Upload Inspiration (Optional)</Label>
                  <Button
                    variant="outline"
                    className="w-full mt-2"
                    onClick={() => fileInputRef.current?.click()}
                  >
                    <Upload className="w-4 h-4 mr-2" />
                    {uploadedImage ? "Change Image" : "Upload Image"}
                  </Button>
                  <input
                    ref={fileInputRef}
                    type="file"
                    accept="image/*"
                    onChange={handleImageUpload}
                    className="hidden"
                  />
                  {uploadedImage && (
                    <div className="mt-4 rounded-lg overflow-hidden border">
                      <img src={uploadedImage} alt="Inspiration" className="w-full h-48 object-cover" />
                    </div>
                  )}
                </div>

                <Button
                  onClick={generateRecommendations}
                  disabled={isGenerating || (!preferences && !uploadedImage)}
                  className="w-full bg-gradient-to-r from-purple-500 to-pink-500"
                >
                  {isGenerating ? (
                    <>
                      <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                      Analyzing Your Style...
                    </>
                  ) : (
                    <>
                      <Sparkles className="w-4 h-4 mr-2" />
                      Get Recommendations
                    </>
                  )}
                </Button>
              </CardContent>
            </Card>

            {/* Past Designs Summary */}
            {userDesigns.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Palette className="w-5 h-5 text-purple-500" />
                    Your Design History
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <p className="text-sm text-gray-600 mb-3">
                    AI will analyze your {userDesigns.length} past designs to personalize recommendations
                  </p>
                  <div className="grid grid-cols-5 gap-2">
                    {userDesigns.slice(0, 5).map((design) => (
                      <div
                        key={design.id}
                        className="aspect-square rounded-lg"
                        style={{ backgroundColor: design.base_color }}
                      />
                    ))}
                  </div>
                </CardContent>
              </Card>
            )}
          </div>

          {/* Recommendations Section */}
          <div>
            <Card className="min-h-[600px]">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-purple-500" />
                  Your Personalized Recommendations
                </CardTitle>
              </CardHeader>
              <CardContent>
                {!recommendations ? (
                  <div className="flex flex-col items-center justify-center h-96 text-center">
                    <Shirt className="w-16 h-16 text-gray-300 mb-4" />
                    <p className="text-gray-500">
                      Share your preferences and let AI suggest the perfect design elements for you!
                    </p>
                  </div>
                ) : (
                  <div className="space-y-6">
                    {/* Color Palettes */}
                    {recommendations.color_palettes?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3">Recommended Color Palettes</h3>
                        <div className="space-y-3">
                          {recommendations.color_palettes.map((palette, i) => (
                            <div key={i} className="bg-gray-50 rounded-lg p-4">
                              <p className="font-medium mb-2">{palette.name}</p>
                              <div className="flex gap-2 mb-2">
                                {palette.colors?.map((color, j) => (
                                  <div
                                    key={j}
                                    className="w-12 h-12 rounded-lg border-2 border-white shadow-sm"
                                    style={{ backgroundColor: color }}
                                    title={color}
                                  />
                                ))}
                              </div>
                              <p className="text-sm text-gray-600">{palette.description}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Next Design Ideas */}
                    {recommendations.next_designs?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3">Next Design Ideas</h3>
                        <div className="grid grid-cols-1 gap-2">
                          {recommendations.next_designs.map((idea, i) => (
                            <div key={i} className="flex items-start gap-2 bg-purple-50 rounded-lg p-3">
                              <Lightbulb className="w-5 h-5 text-purple-600 mt-0.5 flex-shrink-0" />
                              <p className="text-sm text-gray-700">{idea}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Graphics & Patterns */}
                    {recommendations.graphics_patterns?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3">Graphics & Patterns</h3>
                        <div className="flex flex-wrap gap-2">
                          {recommendations.graphics_patterns.map((pattern, i) => (
                            <Badge key={i} variant="outline" className="text-sm">
                              {pattern}
                            </Badge>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Material Upgrades */}
                    {recommendations.material_upgrades?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3">Material Recommendations</h3>
                        <div className="space-y-2">
                          {recommendations.material_upgrades.map((material, i) => (
                            <div key={i} className="flex items-center gap-2 text-sm text-gray-700">
                              <div className="w-2 h-2 rounded-full bg-green-500" />
                              {material}
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Style Evolution */}
                    {recommendations.style_evolution && (
                      <div className="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-4">
                        <h3 className="font-semibold text-lg mb-2">Your Style Journey</h3>
                        <p className="text-sm text-gray-700">{recommendations.style_evolution}</p>
                      </div>
                    )}

                    <Button
                      className="w-full bg-gradient-to-r from-purple-500 to-pink-500"
                      onClick={() => navigate(createPageUrl("CustomDesigner"))}
                    >
                      <Palette className="w-4 h-4 mr-2" />
                      Start Designing
                    </Button>
                  </div>
                )}
              </CardContent>
            </Card>

            {/* Trend Analysis Link */}
            <Card className="bg-gradient-to-r from-orange-50 to-pink-50 border-orange-200">
              <CardContent className="p-6">
                <h3 className="text-lg font-semibold text-gray-900 mb-2">
                  Explore Fashion Trends
                </h3>
                <p className="text-sm text-gray-600 mb-4">
                  Get AI-powered insights on current fashion trends, popular colors, and trending styles
                </p>
                <Button
                  onClick={() => navigate(createPageUrl("FashionTrends"))}
                  className="bg-gradient-to-r from-orange-500 to-pink-500"
                >
                  <Sparkles className="w-4 h-4 mr-2" />
                  View Trends
                </Button>
              </CardContent>
            </Card>

            {/* Affiliate Product Suggestions */}
            {recommendations && (
              <ProductSuggestions
                styleTags={userProfile?.style_preferences || []}
                priceRange={userProfile?.budget_range}
                title="Products You Might Love"
              />
            )}
          </div>
        </div>
      </div>
    </div>
  );
}