import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { motion, AnimatePresence } from "framer-motion";
import {
  Calendar,
  Sparkles,
  ShoppingBag,
  CheckCircle,
  Loader2,
  ExternalLink,
  Shirt,
  Upload,
  Save,
  Image as ImageIcon,
  Palette,
  Heart,
  X
} from "lucide-react";
import AuthRequiredModal, { useAuthRequired } from "../components/auth/AuthRequiredModal";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from "@/components/ui/dialog";
import { Skeleton } from "@/components/ui/skeleton";
import { Badge } from "@/components/ui/badge";

export default function OccasionPlanner() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { user, isLoading: authLoading, isAuthenticated, showAuthModal, authModalConfig, requireAuth, closeAuthModal } = useAuthRequired();
  const [occasionType, setOccasionType] = React.useState("");
  const [additionalNotes, setAdditionalNotes] = React.useState("");
  const [suggestions, setSuggestions] = React.useState(null);
  const [isGenerating, setIsGenerating] = React.useState(false);
  const [uploadedImage, setUploadedImage] = React.useState(null);
  const [isAnalyzingImage, setIsAnalyzingImage] = React.useState(false);
  const [showSaveDialog, setShowSaveDialog] = React.useState(false);
  const [outfitToSave, setOutfitToSave] = React.useState(null);
  const [mood, setMood] = React.useState("");
  const [colorPreference, setColorPreference] = React.useState("");
  const [mustIncludeItems, setMustIncludeItems] = React.useState([]);
  const [avoidItems, setAvoidItems] = React.useState([]);
  const [mustIncludeInput, setMustIncludeInput] = React.useState("");
  const [avoidInput, setAvoidInput] = React.useState("");
  const fileInputRef = React.useRef(null);

  const { data: userProfile } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      if (!user?.email) return null;
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0] || null;
    },
    enabled: !!user?.email,
  });

  const { data: wardrobeItems = [] } = useQuery({
    queryKey: ['wardrobe', user?.email],
    queryFn: () => base44.entities.WardrobeItem.filter({ user_email: user.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  const { data: affiliateProducts = [] } = useQuery({
    queryKey: ['affiliateProducts'],
    queryFn: () => base44.entities.AffiliateProduct.filter({ is_active: true }),
    initialData: [],
  });

  const { data: outfitHistory = [] } = useQuery({
    queryKey: ['outfitHistory', user?.email],
    queryFn: () => base44.entities.OutfitHistory.filter({ user_email: user.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  const saveOutfitMutation = useMutation({
    mutationFn: (outfitData) => base44.entities.OutfitHistory.create({
      ...outfitData,
      user_email: user.email
    }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['outfitHistory'] });
      setShowSaveDialog(false);
      setOutfitToSave(null);
      alert("Outfit saved to your history!");
    },
  });

  const occasions = [
    { value: "wedding", label: "Wedding" },
    { value: "job_interview", label: "Job Interview" },
    { value: "date", label: "Date" },
    { value: "party", label: "Party" },
    { value: "casual_hangout", label: "Casual Hangout" },
    { value: "business_meeting", label: "Business Meeting" },
    { value: "dinner", label: "Dinner" },
    { value: "brunch", label: "Brunch" },
    { value: "concert", label: "Concert" },
    { value: "beach", label: "Beach" },
    { value: "gym", label: "Gym" },
    { value: "formal_event", label: "Formal Event" },
    { value: "other", label: "Other" }
  ];

  const handleImageUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setIsAnalyzingImage(true);
    try {
      const { file_url } = await base44.integrations.Core.UploadFile({ file });
      setUploadedImage(file_url);

      // Analyze image for style
      const analysisPrompt = `Analyze this fashion image and extract:
1. Dominant colors (hex codes)
2. Style aesthetic (casual, formal, bohemian, etc.)
3. Clothing categories visible
4. Occasion suitability
5. Season appropriateness

Format as JSON.`;

      const analysis = await base44.integrations.Core.InvokeLLM({
        prompt: analysisPrompt,
        file_urls: [file_url],
        response_json_schema: {
          type: "object",
          properties: {
            colors: { type: "array", items: { type: "string" } },
            style: { type: "string" },
            categories: { type: "array", items: { type: "string" } },
            occasion: { type: "string" },
            season: { type: "string" }
          }
        }
      });

      // Set occasion based on image analysis
      if (analysis.occasion) {
        const matchedOccasion = occasions.find(o => 
          o.label.toLowerCase().includes(analysis.occasion.toLowerCase())
        );
        if (matchedOccasion) {
          setOccasionType(matchedOccasion.value);
        }
      }

      // Auto-generate suggestions
      await generateSuggestionsWithImage(analysis, file_url);
    } catch (error) {
      console.error("Error analyzing image:", error);
    }
    setIsAnalyzingImage(false);
  };

  const generateSuggestionsWithImage = async (imageAnalysis, imageUrl) => {
    setIsGenerating(true);
    try {
      const relevantProducts = affiliateProducts.filter(product => 
        product.occasion_types?.includes(occasionType)
      );

      const prompt = `Based on the uploaded outfit image analysis:
- Colors: ${imageAnalysis.colors?.join(', ')}
- Style: ${imageAnalysis.style}
- Categories: ${imageAnalysis.categories?.join(', ')}

Suggest a complete outfit for ${occasions.find(o => o.value === occasionType)?.label || occasionType}.
${userProfile ? `User profile: ${JSON.stringify(userProfile)}` : ""}
${wardrobeItems.length > 0 ? `Wardrobe: ${wardrobeItems.slice(0, 10).map(i => i.item_name).join(', ')}` : ""}

Provide outfit suggestions matching the image style.`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt: prompt,
        file_urls: [imageUrl],
        response_json_schema: {
          type: "object",
          properties: {
            outfit_from_wardrobe: { type: "array", items: { type: "string" } },
            items_to_buy: { 
              type: "array", 
              items: { 
                type: "object",
                properties: {
                  category: { type: "string" },
                  description: { type: "string" }
                }
              }
            },
            styling_tips: { type: "string" },
            accessories: { type: "string" }
          }
        }
      });

      result.recommended_products = relevantProducts.slice(0, 6);
      result.inspired_by_image = true;
      setSuggestions(result);
    } catch (error) {
      console.error("Error generating suggestions:", error);
    }
    setIsGenerating(false);
  };

  const generateSuggestions = async () => {
    if (!occasionType) return;

    setIsGenerating(true);
    try {
      // Filter affiliate products by occasion
      const relevantProducts = affiliateProducts.filter(product => 
        product.occasion_types?.includes(occasionType)
      );

      // Analyze outfit history for preferences
      const highRatedOutfits = outfitHistory.filter(o => o.rating >= 4);
      const favoriteOutfits = outfitHistory.filter(o => o.is_favorite);
      
      const historyInsights = highRatedOutfits.length > 0 ? `
Previous High-Rated Outfits (User loves these!):
${highRatedOutfits.slice(0, 3).map(o => 
  `- ${o.occasion_type} (${o.rating}★): ${o.outfit_description || 'N/A'}`
).join('\n')}` : "";

      const profileInfo = userProfile ? `
User Profile:
- Gender: ${userProfile.gender}
- Body Type: ${userProfile.body_type}
- Skin Tone: ${userProfile.skin_tone}
- Style Preferences: ${userProfile.style_preferences?.join(', ')}
- Favorite Colors: ${userProfile.favorite_colors?.join(', ')}
- Comfort Priority: ${userProfile.comfort_priority}
- Budget: ${userProfile.budget_range}
- Sizes: Top ${userProfile.sizes?.top}, Bottom ${userProfile.sizes?.bottom}
      ` : "User hasn't completed their profile yet.";

      const wardrobeInfo = wardrobeItems.length > 0 
        ? `\n\nUser's Wardrobe (${wardrobeItems.length} items):\n${wardrobeItems.map(item => 
            `- ${item.item_name} (${item.category}, ${item.colors?.join('/')})`
          ).join('\n')}`
        : "\n\nUser hasn't added any wardrobe items yet. MUST recommend products to purchase.";

      const moodInfo = mood ? `\nUser's current mood: ${mood}` : "";
    const colorInfo = colorPreference ? `\nPreferred colors for this outfit: ${colorPreference}` : "";
    const mustIncludeInfo = mustIncludeItems.length > 0 ? `\nMUST include these items: ${mustIncludeItems.join(', ')}` : "";
    const avoidInfo = avoidItems.length > 0 ? `\nAVOID these items: ${avoidItems.join(', ')}` : "";

    const prompt = `You are a professional fashion stylist. Create personalized outfit suggestions for this occasion: ${occasions.find(o => o.value === occasionType)?.label}

${profileInfo}
${wardrobeInfo}
${historyInsights}
${moodInfo}
${colorInfo}
${mustIncludeInfo}
${avoidInfo}

Additional Notes from User: ${additionalNotes || "None"}

IMPORTANT: Prioritize styles similar to their high-rated past outfits!
${mustIncludeItems.length > 0 ? "CRITICAL: The outfit MUST incorporate the specified items!" : ""}
${avoidItems.length > 0 ? "CRITICAL: Do NOT suggest the avoided items!" : ""}
${mood ? "Match the outfit style to the user's mood!" : ""}
${colorPreference ? "Use the preferred color palette!" : ""}

Please provide in JSON format:
1. outfit_from_wardrobe: Array of wardrobe items to wear (if available)
2. items_to_buy: Array of {category, description} for items they need
3. styling_tips: String with styling advice
4. accessories: String with accessory suggestions

${wardrobeItems.length === 0 ? "⚠️ User has NO wardrobe items. Focus on items_to_buy!" : ""}`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt: prompt,
        add_context_from_internet: false,
        response_json_schema: {
          type: "object",
          properties: {
            outfit_from_wardrobe: { type: "array", items: { type: "string" } },
            items_to_buy: { 
              type: "array", 
              items: { 
                type: "object",
                properties: {
                  category: { type: "string" },
                  description: { type: "string" }
                }
              }
            },
            styling_tips: { type: "string" },
            accessories: { type: "string" }
          }
        }
      });

      // Add affiliate product recommendations
      result.recommended_products = relevantProducts.slice(0, 6);
      result.occasion_type = occasionType;
      result.additional_notes = additionalNotes;

      setSuggestions(result);
    } catch (error) {
      console.error("Error generating suggestions:", error);
    }
    setIsGenerating(false);
  };

  const handleImageUploadClick = () => {
    if (!requireAuth({
      title: "Upload an Image",
      message: "Sign in to upload images for AI-powered style analysis and personalized outfit suggestions."
    })) return;
    fileInputRef.current?.click();
  };

  const handleSaveOutfit = () => {
    if (!requireAuth({
      title: "Save This Outfit",
      message: "Sign in to save outfits to your history and access them anytime. Build your style portfolio!"
    })) return;
    setOutfitToSave(suggestions);
    setShowSaveDialog(true);
  };

  const handleGenerateSuggestions = () => {
    if (!occasionType) return;
    
    if (!user && (wardrobeItems.length > 0 || userProfile)) {
      // If they have profile/wardrobe data but not signed in, require auth
      if (!requireAuth({
        title: "Get Personalized Suggestions",
        message: "Sign in to get outfit recommendations based on your wardrobe and style profile."
      })) return;
    }
    
    generateSuggestions();
  };

  if (authLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500" />
      </div>
    );
  }

  return (
    <div className="p-4 md:p-8 max-w-5xl mx-auto">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="mb-8"
      >
        <div className="flex items-center gap-3 mb-2">
          <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-400 to-blue-400 flex items-center justify-center">
            <Calendar className="w-6 h-6 text-white" />
          </div>
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Plan Your Outfit</h1>
            <p className="text-gray-600">Get AI-powered suggestions for any occasion</p>
          </div>
        </div>
      </motion.div>

      {user && !userProfile?.profile_completed && (
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
        >
          <Card className="mb-6 bg-gradient-to-r from-yellow-50 to-orange-50 border-yellow-200">
            <CardContent className="p-6">
              <div className="flex items-start gap-4">
                <Sparkles className="w-6 h-6 text-yellow-600 flex-shrink-0 mt-1" />
                <div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-1">
                    Complete your profile for better suggestions!
                  </h3>
                  <p className="text-gray-600 mb-3">
                    Tell us about your style preferences to get personalized recommendations
                  </p>
                  <Button
                    onClick={() => navigate(createPageUrl("StyleProfile"))}
                    variant="outline"
                    className="border-yellow-300 hover:bg-yellow-50"
                  >
                    Complete Profile
                  </Button>
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>
      )}

      <div className="grid lg:grid-cols-2 gap-6">
        {/* Input Section */}
        <motion.div
          initial={{ opacity: 0, x: -20 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: 0.2 }}
        >
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Sparkles className="w-5 h-5 text-purple-500" />
                Tell Us About Your Occasion
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div>
                <Label htmlFor="occasion">Occasion Type *</Label>
                <Select value={occasionType} onValueChange={setOccasionType}>
                  <SelectTrigger>
                    <SelectValue placeholder="Select an occasion" />
                  </SelectTrigger>
                  <SelectContent>
                    {occasions.map((occasion) => (
                      <SelectItem key={occasion.value} value={occasion.value}>
                        {occasion.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              <div>
                <Label htmlFor="notes">Additional Details (Optional)</Label>
                <Textarea
                  id="notes"
                  value={additionalNotes}
                  onChange={(e) => setAdditionalNotes(e.target.value)}
                  placeholder="Any specific requirements? Weather conditions? Dress code? Tell us more..."
                  rows={3}
                  className="resize-none"
                />
              </div>

              {/* Mood Selection */}
              <div>
                <Label className="flex items-center gap-2">
                  <Heart className="w-4 h-4 text-pink-500" />
                  How are you feeling?
                </Label>
                <Select value={mood} onValueChange={setMood}>
                  <SelectTrigger className="mt-2">
                    <SelectValue placeholder="Select your mood (optional)" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value={null}>No preference</SelectItem>
                    <SelectItem value="confident">Confident & Bold</SelectItem>
                    <SelectItem value="romantic">Romantic & Soft</SelectItem>
                    <SelectItem value="calm">Calm & Relaxed</SelectItem>
                    <SelectItem value="powerful">Powerful & Professional</SelectItem>
                    <SelectItem value="playful">Playful & Fun</SelectItem>
                    <SelectItem value="mysterious">Mysterious & Edgy</SelectItem>
                  </SelectContent>
                </Select>
              </div>

              {/* Color Preference */}
              <div>
                <Label className="flex items-center gap-2">
                  <Palette className="w-4 h-4 text-purple-500" />
                  Color Preference
                </Label>
                <Input
                  value={colorPreference}
                  onChange={(e) => setColorPreference(e.target.value)}
                  placeholder="e.g., earth tones, pastels, all black..."
                  className="mt-2"
                />
              </div>

              {/* Must Include Items */}
              <div>
                <Label>Must Include Items</Label>
                <div className="flex gap-2 mt-2">
                  <Input
                    value={mustIncludeInput}
                    onChange={(e) => setMustIncludeInput(e.target.value)}
                    placeholder="e.g., my new blazer"
                    onKeyPress={(e) => {
                      if (e.key === 'Enter' && mustIncludeInput.trim()) {
                        e.preventDefault();
                        setMustIncludeItems([...mustIncludeItems, mustIncludeInput.trim()]);
                        setMustIncludeInput("");
                      }
                    }}
                  />
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => {
                      if (mustIncludeInput.trim()) {
                        setMustIncludeItems([...mustIncludeItems, mustIncludeInput.trim()]);
                        setMustIncludeInput("");
                      }
                    }}
                  >
                    Add
                  </Button>
                </div>
                {mustIncludeItems.length > 0 && (
                  <div className="flex flex-wrap gap-2 mt-2">
                    {mustIncludeItems.map((item, i) => (
                      <Badge key={i} variant="secondary" className="flex items-center gap-1">
                        {item}
                        <X
                          className="w-3 h-3 cursor-pointer"
                          onClick={() => setMustIncludeItems(mustIncludeItems.filter((_, idx) => idx !== i))}
                        />
                      </Badge>
                    ))}
                  </div>
                )}
              </div>

              {/* Items to Avoid */}
              <div>
                <Label>Items to Avoid</Label>
                <div className="flex gap-2 mt-2">
                  <Input
                    value={avoidInput}
                    onChange={(e) => setAvoidInput(e.target.value)}
                    placeholder="e.g., high heels, bright colors"
                    onKeyPress={(e) => {
                      if (e.key === 'Enter' && avoidInput.trim()) {
                        e.preventDefault();
                        setAvoidItems([...avoidItems, avoidInput.trim()]);
                        setAvoidInput("");
                      }
                    }}
                  />
                  <Button
                    type="button"
                    variant="outline"
                    onClick={() => {
                      if (avoidInput.trim()) {
                        setAvoidItems([...avoidItems, avoidInput.trim()]);
                        setAvoidInput("");
                      }
                    }}
                  >
                    Add
                  </Button>
                </div>
                {avoidItems.length > 0 && (
                  <div className="flex flex-wrap gap-2 mt-2">
                    {avoidItems.map((item, i) => (
                      <Badge key={i} variant="outline" className="flex items-center gap-1 text-red-600">
                        {item}
                        <X
                          className="w-3 h-3 cursor-pointer"
                          onClick={() => setAvoidItems(avoidItems.filter((_, idx) => idx !== i))}
                        />
                      </Badge>
                    ))}
                  </div>
                )}
              </div>

              {wardrobeItems.length > 0 && (
                <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                  <div className="flex items-center gap-2 text-green-700 mb-2">
                    <Shirt className="w-4 h-4" />
                    <span className="font-medium">
                      You have {wardrobeItems.length} items in your wardrobe
                    </span>
                  </div>
                  <p className="text-sm text-green-600">
                    We'll suggest outfits from your existing clothes to help you save money!
                  </p>
                </div>
              )}

              <Button
                onClick={handleGenerateSuggestions}
                disabled={!occasionType || isGenerating}
                className="w-full bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-600 hover:to-blue-600 text-white py-6 text-lg"
              >
                {isGenerating ? (
                  <>
                    <Loader2 className="w-5 h-5 mr-2 animate-spin" />
                    Generating Your Perfect Outfit...
                  </>
                ) : (
                  <>
                    <Sparkles className="w-5 h-5 mr-2" />
                    {user ? "Get Outfit Suggestions" : "Get Suggestions (Sign in for personalized)"}
                  </>
                )}
              </Button>
            </CardContent>
          </Card>
        </motion.div>

        {/* Suggestions Section */}
        <motion.div
          initial={{ opacity: 0, x: 20 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: 0.3 }}
        >
          <Card className="h-full">
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ShoppingBag className="w-5 h-5 text-blue-500" />
                Your Personalized Suggestions
              </CardTitle>
            </CardHeader>
            <CardContent>
              <AnimatePresence mode="wait">
                {isGenerating ? (
                  <motion.div
                    key="loading"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    exit={{ opacity: 0 }}
                    className="space-y-4"
                  >
                    <Skeleton className="h-4 w-full" />
                    <Skeleton className="h-4 w-5/6" />
                    <Skeleton className="h-4 w-4/6" />
                    <Skeleton className="h-32 w-full rounded-lg" />
                    <Skeleton className="h-4 w-full" />
                    <Skeleton className="h-4 w-3/4" />
                  </motion.div>
                ) : suggestions ? (
                  <motion.div
                    key="suggestions"
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    exit={{ opacity: 0 }}
                    className="space-y-6"
                  >
                    {/* Outfit from Wardrobe */}
                    {suggestions.outfit_from_wardrobe?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3 flex items-center gap-2">
                          <Shirt className="w-5 h-5 text-green-600" />
                          From Your Wardrobe
                        </h3>
                        <div className="space-y-2">
                          {suggestions.outfit_from_wardrobe.map((item, i) => (
                            <div key={i} className="flex items-center gap-2 bg-green-50 rounded-lg p-3">
                              <CheckCircle className="w-5 h-5 text-green-600" />
                              <p className="text-sm text-gray-700">{item}</p>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {/* Items to Buy */}
                    {suggestions.items_to_buy?.length > 0 && (
                      <div>
                        <h3 className="font-semibold text-lg mb-3 flex items-center gap-2">
                          <ShoppingBag className="w-5 h-5 text-purple-600" />
                          Items to Complete Your Look
                        </h3>
                        <div className="space-y-2 mb-4">
                          {suggestions.items_to_buy.map((item, i) => (
                            <div key={i} className="bg-purple-50 rounded-lg p-3">
                              <p className="text-sm font-medium text-gray-900">{item.category || item}</p>
                              {item.description && (
                                <p className="text-xs text-gray-600 mt-1">{item.description}</p>
                              )}
                            </div>
                          ))}
                        </div>

                        {/* Recommended Products */}
                        {suggestions.recommended_products?.length > 0 && (
                          <div>
                            <h4 className="font-medium text-sm mb-3 text-gray-700">Recommended Products</h4>
                            <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                              {suggestions.recommended_products.map((product) => (
                                <a
                                  key={product.id}
                                  href={product.product_url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  className="block bg-white rounded-lg overflow-hidden border hover:shadow-lg transition-all"
                                >
                                  <div className="aspect-square bg-gray-100">
                                    {product.image_url ? (
                                      <img
                                        src={product.image_url}
                                        alt={product.product_name}
                                        className="w-full h-full object-cover"
                                      />
                                    ) : (
                                      <div className="w-full h-full flex items-center justify-center">
                                        <ShoppingBag className="w-8 h-8 text-gray-300" />
                                      </div>
                                    )}
                                  </div>
                                  <div className="p-2">
                                    <p className="text-xs font-medium text-gray-900 line-clamp-2 mb-1">
                                      {product.product_name}
                                    </p>
                                    <div className="flex items-center justify-between">
                                      <span className="text-xs font-semibold text-purple-600">
                                        ₹{product.price}
                                      </span>
                                      <ExternalLink className="w-3 h-3 text-gray-400" />
                                    </div>
                                  </div>
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    )}

                    {/* Styling Tips */}
                    {suggestions.styling_tips && (
                      <div className="bg-blue-50 rounded-lg p-4">
                        <h3 className="font-semibold text-lg mb-2">Styling Tips</h3>
                        <p className="text-sm text-gray-700">{suggestions.styling_tips}</p>
                      </div>
                    )}

                    {/* Accessories */}
                    {suggestions.accessories && (
                      <div className="bg-pink-50 rounded-lg p-4">
                        <h3 className="font-semibold text-lg mb-2">Accessories</h3>
                        <p className="text-sm text-gray-700">{suggestions.accessories}</p>
                      </div>
                    )}

                    <div className="flex gap-3 mt-6">
                      <Button
                        onClick={() => {
                          setSuggestions(null);
                          setOccasionType("");
                          setAdditionalNotes("");
                          setUploadedImage(null);
                        }}
                        variant="outline"
                        className="flex-1"
                      >
                        Start Over
                      </Button>
                      <Button
                        onClick={handleSaveOutfit}
                        className="flex-1 bg-gradient-to-r from-blue-500 to-purple-500"
                      >
                        <Save className="w-4 h-4 mr-2" />
                        Save Outfit
                      </Button>
                      <Button
                        onClick={() => navigate(createPageUrl("MyWardrobe"))}
                        className="flex-1 bg-gradient-to-r from-green-500 to-emerald-500"
                      >
                        <Shirt className="w-4 h-4 mr-2" />
                        Wardrobe
                      </Button>
                    </div>
                  </motion.div>
                ) : (
                  <motion.div
                    key="empty"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    exit={{ opacity: 0 }}
                    className="text-center py-12"
                  >
                    <div className="w-16 h-16 rounded-full bg-gradient-to-br from-purple-100 to-blue-100 flex items-center justify-center mx-auto mb-4">
                      <Sparkles className="w-8 h-8 text-purple-500" />
                    </div>
                    <h3 className="text-lg font-semibold text-gray-900 mb-2">
                      Ready to look amazing?
                    </h3>
                    <p className="text-gray-600">
                      Select an occasion and click "Get Outfit Suggestions" to see your personalized recommendations
                    </p>
                  </motion.div>
                )}
              </AnimatePresence>
            </CardContent>
          </Card>
        </motion.div>
      </div>

      <AuthRequiredModal
        isOpen={showAuthModal}
        onClose={closeAuthModal}
        {...authModalConfig}
      />
    </div>
  );
}
