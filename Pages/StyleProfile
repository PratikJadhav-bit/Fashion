import React from "react";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { base44 } from "@/api/base44Client";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { motion } from "framer-motion";
import { User, Sparkles, CheckCircle, X } from "lucide-react";
import { Skeleton } from "@/components/ui/skeleton";

export default function StyleProfile() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [user, setUser] = React.useState(null);
  const [formData, setFormData] = React.useState({
    full_name: "",
    gender: "",
    body_type: "",
    skin_tone: "",
    favorite_colors: [],
    style_preferences: [],
    comfort_priority: "medium",
    budget_range: "",
    preferred_brands: [],
    occasion_preferences: {
      work: "",
      casual: "",
      party: "",
      formal: "",
      date: ""
    },
    avoid_styles: [],
    sizes: {
      top: "",
      bottom: "",
      dress: "",
      shoe: ""
    }
  });
  const [colorInput, setColorInput] = React.useState("");
  const [brandInput, setBrandInput] = React.useState("");
  const [avoidInput, setAvoidInput] = React.useState("");

  React.useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await base44.auth.me();
        setUser(currentUser);
      } catch (error) {
        // Allow viewing as guest
        setUser(null);
      }
    };
    loadUser();
  }, []);

  const { data: userProfile, isLoading } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      if (!user?.email) return null;
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0] || null;
    },
    enabled: !!user?.email,
  });

  React.useEffect(() => {
    if (userProfile) {
      setFormData({
        full_name: userProfile.full_name || "",
        gender: userProfile.gender || "",
        body_type: userProfile.body_type || "",
        skin_tone: userProfile.skin_tone || "",
        favorite_colors: userProfile.favorite_colors || [],
        style_preferences: userProfile.style_preferences || [],
        comfort_priority: userProfile.comfort_priority || "medium",
        budget_range: userProfile.budget_range || "",
        preferred_brands: userProfile.preferred_brands || [],
        occasion_preferences: userProfile.occasion_preferences || {
          work: "", casual: "", party: "", formal: "", date: ""
        },
        avoid_styles: userProfile.avoid_styles || [],
        sizes: userProfile.sizes || { top: "", bottom: "", dress: "", shoe: "" }
      });
    }
  }, [userProfile]);

  const saveMutation = useMutation({
    mutationFn: async (data) => {
      const profileData = {
        ...data,
        user_email: user.email,
        profile_completed: true
      };

      if (userProfile) {
        return await base44.entities.UserProfile.update(userProfile.id, profileData);
      } else {
        return await base44.entities.UserProfile.create(profileData);
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['userProfile'] });
      navigate(createPageUrl("Dashboard"));
    },
  });

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!user) {
      base44.auth.redirectToLogin(createPageUrl("StyleProfile"));
      return;
    }
    saveMutation.mutate(formData);
  };

  const addColor = () => {
    if (colorInput && !formData.favorite_colors.includes(colorInput)) {
      setFormData({
        ...formData,
        favorite_colors: [...formData.favorite_colors, colorInput]
      });
      setColorInput("");
    }
  };

  const removeColor = (color) => {
    setFormData({
      ...formData,
      favorite_colors: formData.favorite_colors.filter(c => c !== color)
    });
  };

  const addBrand = () => {
    if (brandInput && !formData.preferred_brands.includes(brandInput)) {
      setFormData({
        ...formData,
        preferred_brands: [...formData.preferred_brands, brandInput]
      });
      setBrandInput("");
    }
  };

  const removeBrand = (brand) => {
    setFormData({
      ...formData,
      preferred_brands: formData.preferred_brands.filter(b => b !== brand)
    });
  };

  const addAvoidStyle = () => {
    if (avoidInput && !formData.avoid_styles.includes(avoidInput)) {
      setFormData({
        ...formData,
        avoid_styles: [...formData.avoid_styles, avoidInput]
      });
      setAvoidInput("");
    }
  };

  const removeAvoidStyle = (style) => {
    setFormData({
      ...formData,
      avoid_styles: formData.avoid_styles.filter(s => s !== style)
    });
  };

  const toggleStylePreference = (style) => {
    const current = formData.style_preferences || [];
    if (current.includes(style)) {
      setFormData({
        ...formData,
        style_preferences: current.filter(s => s !== style)
      });
    } else {
      setFormData({
        ...formData,
        style_preferences: [...current, style]
      });
    }
  };

  const styleOptions = [
    "casual", "formal", "bohemian", "minimalist", 
    "vintage", "sporty", "elegant", "edgy", "romantic"
  ];

  if (isLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500" />
      </div>
    );
  }

  if (!user) {
    return (
      <div className="p-4 md:p-8 max-w-4xl mx-auto">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <div className="flex items-center gap-3 mb-2">
            <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-400 to-purple-400 flex items-center justify-center">
              <User className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-3xl font-bold text-gray-900">Style Profile</h1>
              <p className="text-gray-600">Create your personalized fashion profile</p>
            </div>
          </div>
        </motion.div>

        <Card>
          <CardContent className="p-12 text-center">
            <div className="w-20 h-20 rounded-full bg-gradient-to-br from-purple-100 to-pink-100 flex items-center justify-center mx-auto mb-6">
              <Sparkles className="w-10 h-10 text-purple-500" />
            </div>
            <h2 className="text-2xl font-bold text-gray-900 mb-3">Unlock Personalized Styling</h2>
            <p className="text-gray-600 mb-6 max-w-md mx-auto">
              Sign in to create your style profile and get AI-powered outfit recommendations tailored to your unique preferences, body type, and lifestyle.
            </p>
            <Button
              onClick={() => base44.auth.redirectToLogin(createPageUrl("StyleProfile"))}
              className="bg-gradient-to-r from-pink-500 to-purple-500 text-lg px-8 py-6"
            >
              Sign In to Create Profile
            </Button>
          </CardContent>
        </Card>
      </div>
    );
  }

  return (
    <div className="p-4 md:p-8 max-w-4xl mx-auto">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="mb-8"
      >
        <div className="flex items-center gap-3 mb-2">
          <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-400 to-purple-400 flex items-center justify-center">
            <User className="w-6 h-6 text-white" />
          </div>
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Your Style Profile</h1>
            <p className="text-gray-600">Help us understand your unique style</p>
          </div>
        </div>
      </motion.div>

      <form onSubmit={handleSubmit}>
        <div className="space-y-6">
          {/* Basic Info */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.1 }}
          >
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-pink-500" />
                  Basic Information
                </CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <Label htmlFor="full_name">Full Name</Label>
                    <Input
                      id="full_name"
                      value={formData.full_name}
                      onChange={(e) => setFormData({ ...formData, full_name: e.target.value })}
                      placeholder="Your name"
                      required
                    />
                  </div>
                  <div>
                    <Label htmlFor="gender">Gender</Label>
                    <Select
                      value={formData.gender}
                      onValueChange={(value) => setFormData({ ...formData, gender: value })}
                    >
                      <SelectTrigger>
                        <SelectValue placeholder="Select gender" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="male">Male</SelectItem>
                        <SelectItem value="female">Female</SelectItem>
                        <SelectItem value="non-binary">Non-binary</SelectItem>
                        <SelectItem value="prefer_not_to_say">Prefer not to say</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Body & Skin */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.2 }}
          >
            <Card>
              <CardHeader>
                <CardTitle>Body Type & Skin Tone</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <Label htmlFor="body_type">Body Type</Label>
                    <Select
                      value={formData.body_type}
                      onValueChange={(value) => setFormData({ ...formData, body_type: value })}
                    >
                      <SelectTrigger>
                        <SelectValue placeholder="Select body type" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="petite">Petite</SelectItem>
                        <SelectItem value="athletic">Athletic</SelectItem>
                        <SelectItem value="curvy">Curvy</SelectItem>
                        <SelectItem value="plus_size">Plus Size</SelectItem>
                        <SelectItem value="tall">Tall</SelectItem>
                        <SelectItem value="slim">Slim</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                  <div>
                    <Label htmlFor="skin_tone">Skin Tone</Label>
                    <Select
                      value={formData.skin_tone}
                      onValueChange={(value) => setFormData({ ...formData, skin_tone: value })}
                    >
                      <SelectTrigger>
                        <SelectValue placeholder="Select skin tone" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="fair">Fair</SelectItem>
                        <SelectItem value="light">Light</SelectItem>
                        <SelectItem value="medium">Medium</SelectItem>
                        <SelectItem value="olive">Olive</SelectItem>
                        <SelectItem value="tan">Tan</SelectItem>
                        <SelectItem value="deep">Deep</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Style Preferences */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.3 }}
          >
            <Card>
              <CardHeader>
                <CardTitle>Style Preferences</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div>
                  <Label className="mb-3 block">What styles do you love?</Label>
                  <div className="flex flex-wrap gap-2">
                    {styleOptions.map((style) => (
                      <Badge
                        key={style}
                        variant={formData.style_preferences?.includes(style) ? "default" : "outline"}
                        className={`cursor-pointer px-4 py-2 text-sm transition-all ${
                          formData.style_preferences?.includes(style)
                            ? "bg-gradient-to-r from-pink-500 to-purple-500 text-white"
                            : "hover:border-pink-400"
                        }`}
                        onClick={() => toggleStylePreference(style)}
                      >
                        {style.charAt(0).toUpperCase() + style.slice(1)}
                        {formData.style_preferences?.includes(style) && (
                          <CheckCircle className="ml-2 w-3 h-3" />
                        )}
                      </Badge>
                    ))}
                  </div>
                </div>

                <div>
                  <Label htmlFor="favorite_colors" className="mb-3 block">Favorite Colors</Label>
                  <div className="flex gap-2 mb-3">
                    <Input
                      id="favorite_colors"
                      value={colorInput}
                      onChange={(e) => setColorInput(e.target.value)}
                      placeholder="Enter a color (e.g., navy blue)"
                      onKeyPress={(e) => {
                        if (e.key === 'Enter') {
                          e.preventDefault();
                          addColor();
                        }
                      }}
                    />
                    <Button type="button" onClick={addColor} variant="outline">
                      Add
                    </Button>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {formData.favorite_colors.map((color) => (
                      <Badge key={color} variant="secondary" className="px-3 py-1">
                        {color}
                        <X
                          className="ml-2 w-3 h-3 cursor-pointer"
                          onClick={() => removeColor(color)}
                        />
                      </Badge>
                    ))}
                  </div>
                </div>

                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <Label htmlFor="comfort_priority">Comfort Priority</Label>
                    <Select
                      value={formData.comfort_priority}
                      onValueChange={(value) => setFormData({ ...formData, comfort_priority: value })}
                    >
                      <SelectTrigger>
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="high">High - Comfort first!</SelectItem>
                        <SelectItem value="medium">Medium - Balanced</SelectItem>
                        <SelectItem value="low">Low - Style first!</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                  <div>
                    <Label htmlFor="budget_range">Budget Range</Label>
                    <Select
                      value={formData.budget_range}
                      onValueChange={(value) => setFormData({ ...formData, budget_range: value })}
                    >
                      <SelectTrigger>
                        <SelectValue placeholder="Select budget" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="budget_friendly">Budget Friendly</SelectItem>
                        <SelectItem value="moderate">Moderate</SelectItem>
                        <SelectItem value="luxury">Luxury</SelectItem>
                        <SelectItem value="mixed">Mixed</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Brands & Occasion Preferences */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.4 }}
          >
            <Card>
              <CardHeader>
                <CardTitle>Brands & Occasions</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div>
                  <Label className="mb-3 block">Preferred Brands</Label>
                  <div className="flex gap-2 mb-3">
                    <Input
                      value={brandInput}
                      onChange={(e) => setBrandInput(e.target.value)}
                      placeholder="e.g., Zara, H&M, Nike"
                      onKeyPress={(e) => {
                        if (e.key === 'Enter') {
                          e.preventDefault();
                          addBrand();
                        }
                      }}
                    />
                    <Button type="button" onClick={addBrand} variant="outline">
                      Add
                    </Button>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {formData.preferred_brands.map((brand) => (
                      <Badge key={brand} variant="secondary" className="px-3 py-1">
                        {brand}
                        <X
                          className="ml-2 w-3 h-3 cursor-pointer"
                          onClick={() => removeBrand(brand)}
                        />
                      </Badge>
                    ))}
                  </div>
                </div>

                <div>
                  <Label className="mb-3 block">Styles to Avoid</Label>
                  <div className="flex gap-2 mb-3">
                    <Input
                      value={avoidInput}
                      onChange={(e) => setAvoidInput(e.target.value)}
                      placeholder="e.g., tight fits, bright colors"
                      onKeyPress={(e) => {
                        if (e.key === 'Enter') {
                          e.preventDefault();
                          addAvoidStyle();
                        }
                      }}
                    />
                    <Button type="button" onClick={addAvoidStyle} variant="outline">
                      Add
                    </Button>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {formData.avoid_styles.map((style) => (
                      <Badge key={style} variant="outline" className="px-3 py-1 text-red-600 border-red-300">
                        {style}
                        <X
                          className="ml-2 w-3 h-3 cursor-pointer"
                          onClick={() => removeAvoidStyle(style)}
                        />
                      </Badge>
                    ))}
                  </div>
                </div>

                <div>
                  <Label className="mb-3 block">Occasion Preferences (Optional)</Label>
                  <p className="text-sm text-gray-500 mb-3">Describe your style for each occasion</p>
                  <div className="space-y-3">
                    {[
                      { key: 'work', label: '💼 Work', placeholder: 'e.g., professional, minimal jewelry' },
                      { key: 'casual', label: '👕 Casual', placeholder: 'e.g., comfy, relaxed fit' },
                      { key: 'party', label: '🎉 Party', placeholder: 'e.g., bold colors, statement pieces' },
                      { key: 'formal', label: '🎩 Formal', placeholder: 'e.g., classic, elegant' },
                      { key: 'date', label: '💕 Date Night', placeholder: 'e.g., romantic, confident' }
                    ].map((occasion) => (
                      <div key={occasion.key}>
                        <Label className="text-sm mb-1">{occasion.label}</Label>
                        <Input
                          value={formData.occasion_preferences[occasion.key]}
                          onChange={(e) => setFormData({
                            ...formData,
                            occasion_preferences: {
                              ...formData.occasion_preferences,
                              [occasion.key]: e.target.value
                            }
                          })}
                          placeholder={occasion.placeholder}
                        />
                      </div>
                    ))}
                  </div>
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Sizes */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.5 }}
          >
            <Card>
              <CardHeader>
                <CardTitle>Your Sizes</CardTitle>
              </CardHeader>
              <CardContent>
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <Label htmlFor="size_top">Top Size</Label>
                    <Input
                      id="size_top"
                      value={formData.sizes.top}
                      onChange={(e) => setFormData({
                        ...formData,
                        sizes: { ...formData.sizes, top: e.target.value }
                      })}
                      placeholder="e.g., S, M, L, XL"
                    />
                  </div>
                  <div>
                    <Label htmlFor="size_bottom">Bottom Size</Label>
                    <Input
                      id="size_bottom"
                      value={formData.sizes.bottom}
                      onChange={(e) => setFormData({
                        ...formData,
                        sizes: { ...formData.sizes, bottom: e.target.value }
                      })}
                      placeholder="e.g., 28, 30, 32"
                    />
                  </div>
                  <div>
                    <Label htmlFor="size_dress">Dress Size</Label>
                    <Input
                      id="size_dress"
                      value={formData.sizes.dress}
                      onChange={(e) => setFormData({
                        ...formData,
                        sizes: { ...formData.sizes, dress: e.target.value }
                      })}
                      placeholder="e.g., 2, 4, 6"
                    />
                  </div>
                  <div>
                    <Label htmlFor="size_shoe">Shoe Size</Label>
                    <Input
                      id="size_shoe"
                      value={formData.sizes.shoe}
                      onChange={(e) => setFormData({
                        ...formData,
                        sizes: { ...formData.sizes, shoe: e.target.value }
                      })}
                      placeholder="e.g., 8, 9, 10"
                    />
                  </div>
                </div>
              </CardContent>
            </Card>
          </motion.div>

          {/* Submit */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.6 }}
            className="flex gap-4"
          >
            <Button
              type="submit"
              disabled={saveMutation.isPending}
              className="flex-1 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-600 hover:to-purple-600 text-white py-6 text-lg"
            >
              {saveMutation.isPending ? "Saving..." : "Save Profile"}
            </Button>
            <Button
              type="button"
              variant="outline"
              onClick={() => navigate(createPageUrl("Dashboard"))}
              className="px-8"
            >
              Cancel
            </Button>
          </motion.div>
        </div>
      </form>
    </div>
  );
}
