import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { motion } from "framer-motion";
import {
  Sparkles,
  TrendingUp,
  Users,
  Trophy,
  Heart,
  MessageCircle,
  UserPlus,
  Calendar,
  Clock,
  ChevronRight
} from "lucide-react";
import AuthRequiredModal, { useAuthRequired } from "../components/auth/AuthRequiredModal";
import PersonalizedFeed from "../components/feed/PersonalizedFeed";

export default function Discover() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { user, isAuthenticated, showAuthModal, authModalConfig, requireAuth, closeAuthModal } = useAuthRequired();

  // Fetch trending outfits (most liked)
  const { data: trendingOutfits = [] } = useQuery({
    queryKey: ['trendingOutfits'],
    queryFn: async () => {
      const outfits = await base44.entities.OutfitHistory.filter({ is_favorite: true }, '-created_date', 20);
      return outfits.filter(o => o.outfit_photo_url);
    },
    initialData: [],
  });

  // Fetch popular users (most followers)
  const { data: allFollows = [] } = useQuery({
    queryKey: ['allFollows'],
    queryFn: () => base44.entities.UserFollow.list('-created_date', 100),
    initialData: [],
  });

  // Fetch style challenges
  const { data: challenges = [] } = useQuery({
    queryKey: ['styleChallenges'],
    queryFn: () => base44.entities.StyleChallenge?.list('-created_date', 10) || [],
    initialData: [],
  });

  // Calculate popular users
  const popularUsers = React.useMemo(() => {
    const followerCounts = {};
    allFollows.forEach(follow => {
      followerCounts[follow.following_email] = (followerCounts[follow.following_email] || 0) + 1;
    });
    return Object.entries(followerCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .map(([email, count]) => ({
        email,
        name: allFollows.find(f => f.following_email === email)?.following_name || email.split('@')[0],
        followers: count
      }));
  }, [allFollows]);

  // Check if user follows someone
  const { data: userFollows = [] } = useQuery({
    queryKey: ['userFollows', user?.email],
    queryFn: () => base44.entities.UserFollow.filter({ follower_email: user.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  // Fetch user profile for style DNA
  const { data: userProfile } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      if (!user?.email) return null;
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0] || null;
    },
    enabled: !!user?.email,
  });

  const followMutation = useMutation({
    mutationFn: async ({ email, name }) => {
      const existing = userFollows.find(f => f.following_email === email);
      if (existing) {
        return base44.entities.UserFollow.delete(existing.id);
      } else {
        return base44.entities.UserFollow.create({
          follower_email: user.email,
          following_email: email,
          following_name: name
        });
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['userFollows'] });
      queryClient.invalidateQueries({ queryKey: ['allFollows'] });
    }
  });

  const handleFollow = (email, name) => {
    if (!requireAuth({
      title: "Follow this creator",
      message: "Sign in to follow creators and build your fashion community."
    })) return;
    followMutation.mutate({ email, name });
  };

  const isFollowing = (email) => userFollows.some(f => f.following_email === email);

  // Weekly challenges data
  const weeklyChallenge = {
    title: "Style a White Shirt 3 Ways",
    description: "Show us your creativity! Style a simple white shirt for work, weekend, and a night out.",
    deadline: "5 days left",
    participants: 127,
    prize: "20% off next purchase"
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 p-4 md:p-8">
      <div className="max-w-6xl mx-auto">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
                <Sparkles className="w-6 h-6 text-white" />
              </div>
              <div>
                <h1 className="text-3xl font-bold text-gray-900">Discover</h1>
                <p className="text-gray-600">Trending styles, popular creators & challenges</p>
              </div>
            </div>
          </div>
        </motion.div>

        {/* Weekly Challenge Banner */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
          className="mb-8"
        >
          <Card className="bg-gradient-to-r from-orange-400 via-pink-500 to-purple-500 border-0 text-white overflow-hidden">
            <CardContent className="p-6 md:p-8">
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <div className="flex items-center gap-2 mb-2">
                    <Trophy className="w-5 h-5" />
                    <span className="text-sm font-medium opacity-90">Weekly Challenge</span>
                  </div>
                  <h2 className="text-2xl md:text-3xl font-bold mb-2">{weeklyChallenge.title}</h2>
                  <p className="opacity-90 mb-4">{weeklyChallenge.description}</p>
                  <div className="flex flex-wrap gap-4 text-sm">
                    <div className="flex items-center gap-1">
                      <Clock className="w-4 h-4" />
                      {weeklyChallenge.deadline}
                    </div>
                    <div className="flex items-center gap-1">
                      <Users className="w-4 h-4" />
                      {weeklyChallenge.participants} participants
                    </div>
                    <div className="flex items-center gap-1">
                      <Trophy className="w-4 h-4" />
                      Prize: {weeklyChallenge.prize}
                    </div>
                  </div>
                </div>
                <Button 
                  className="bg-white text-purple-600 hover:bg-gray-100 shrink-0"
                  onClick={() => navigate(createPageUrl("CommunityStyle"))}
                >
                  Join Challenge
                  <ChevronRight className="w-4 h-4 ml-1" />
                </Button>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        <Tabs defaultValue={user ? "foryou" : "trending"} className="w-full">
          <TabsList className="mb-6">
            {user && (
              <TabsTrigger value="foryou" className="flex items-center gap-2">
                <Sparkles className="w-4 h-4" />
                For You
              </TabsTrigger>
            )}
            <TabsTrigger value="trending" className="flex items-center gap-2">
              <TrendingUp className="w-4 h-4" />
              Trending
            </TabsTrigger>
            <TabsTrigger value="creators" className="flex items-center gap-2">
              <Users className="w-4 h-4" />
              Top Creators
            </TabsTrigger>
            <TabsTrigger value="challenges" className="flex items-center gap-2">
              <Trophy className="w-4 h-4" />
              Challenges
            </TabsTrigger>
          </TabsList>

          {/* Personalized Feed */}
          {user && (
            <TabsContent value="foryou">
              <PersonalizedFeed
                user={user}
                userProfile={userProfile}
                userFollows={userFollows}
                onRequireAuth={requireAuth}
              />
            </TabsContent>
          )}

          {/* Trending Outfits */}
          <TabsContent value="trending">
            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {trendingOutfits.length === 0 ? (
                <div className="col-span-full text-center py-12">
                  <TrendingUp className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                  <p className="text-gray-500">No trending outfits yet. Be the first to share!</p>
                  <Button 
                    className="mt-4 bg-gradient-to-r from-purple-500 to-pink-500"
                    onClick={() => navigate(createPageUrl("CommunityStyle"))}
                  >
                    Share Your Look
                  </Button>
                </div>
              ) : (
                trendingOutfits.map((outfit, index) => (
                  <motion.div
                    key={outfit.id}
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: index * 0.05 }}
                  >
                    <Card className="overflow-hidden group cursor-pointer hover:shadow-lg transition-shadow">
                      <div className="aspect-[3/4] bg-gray-100 relative">
                        <img
                          src={outfit.outfit_photo_url}
                          alt={outfit.occasion_name || "Outfit"}
                          className="w-full h-full object-cover group-hover:scale-105 transition-transform"
                        />
                        {index < 3 && (
                          <div className="absolute top-2 left-2">
                            <Badge className="bg-gradient-to-r from-orange-400 to-pink-500">
                              #{index + 1} Trending
                            </Badge>
                          </div>
                        )}
                        <div className="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/60 to-transparent p-3">
                          <p className="text-white text-sm font-medium line-clamp-1">
                            {outfit.occasion_name || outfit.occasion_type}
                          </p>
                          <div className="flex items-center gap-3 text-white/80 text-xs mt-1">
                            <span className="flex items-center gap-1">
                              <Heart className="w-3 h-3" fill="currentColor" />
                              {outfit.rating || 0}
                            </span>
                          </div>
                        </div>
                      </div>
                    </Card>
                  </motion.div>
                ))
              )}
            </div>
          </TabsContent>

          {/* Top Creators */}
          <TabsContent value="creators">
            <div className="grid gap-4">
              {popularUsers.length === 0 ? (
                <div className="text-center py-12">
                  <Users className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                  <p className="text-gray-500">No creators yet. Start following others!</p>
                </div>
              ) : (
                popularUsers.map((creator, index) => (
                  <motion.div
                    key={creator.email}
                    initial={{ opacity: 0, x: -20 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ delay: index * 0.05 }}
                  >
                    <Card className="hover:shadow-md transition-shadow">
                      <CardContent className="p-4 flex items-center justify-between">
                        <div className="flex items-center gap-4">
                          <div className="relative">
                            <div className="w-14 h-14 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center text-white font-bold text-xl">
                              {creator.name[0].toUpperCase()}
                            </div>
                            {index < 3 && (
                              <div className="absolute -top-1 -right-1 w-6 h-6 rounded-full bg-yellow-400 flex items-center justify-center text-xs font-bold">
                                {index + 1}
                              </div>
                            )}
                          </div>
                          <div>
                            <h3 className="font-semibold text-lg">{creator.name}</h3>
                            <p className="text-sm text-gray-500">{creator.followers} followers</p>
                          </div>
                        </div>
                        {creator.email !== user?.email && (
                          <Button
                            variant={isFollowing(creator.email) ? "outline" : "default"}
                            size="sm"
                            onClick={() => handleFollow(creator.email, creator.name)}
                            disabled={followMutation.isPending}
                            className={!isFollowing(creator.email) ? "bg-gradient-to-r from-purple-500 to-pink-500" : ""}
                          >
                            <UserPlus className="w-4 h-4 mr-1" />
                            {isFollowing(creator.email) ? "Following" : "Follow"}
                          </Button>
                        )}
                      </CardContent>
                    </Card>
                  </motion.div>
                ))
              )}
            </div>
          </TabsContent>

          {/* Challenges */}
          <TabsContent value="challenges">
            <div className="grid md:grid-cols-2 gap-6">
              {/* Current Challenge */}
              <Card className="border-2 border-purple-200">
                <CardHeader>
                  <div className="flex items-center gap-2">
                    <Badge className="bg-green-500">Active</Badge>
                    <CardTitle className="text-lg">This Week's Challenge</CardTitle>
                  </div>
                </CardHeader>
                <CardContent>
                  <h3 className="text-xl font-bold mb-2">{weeklyChallenge.title}</h3>
                  <p className="text-gray-600 mb-4">{weeklyChallenge.description}</p>
                  <div className="flex flex-wrap gap-3 mb-4 text-sm text-gray-500">
                    <span className="flex items-center gap-1">
                      <Clock className="w-4 h-4" />
                      {weeklyChallenge.deadline}
                    </span>
                    <span className="flex items-center gap-1">
                      <Users className="w-4 h-4" />
                      {weeklyChallenge.participants} joined
                    </span>
                  </div>
                  <Button className="w-full bg-gradient-to-r from-purple-500 to-pink-500">
                    Participate Now
                  </Button>
                </CardContent>
              </Card>

              {/* Past Challenges */}
              <Card>
                <CardHeader>
                  <CardTitle className="text-lg">Past Challenges</CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  {[
                    { title: "Monochrome Monday", winner: "FashionQueen", participants: 89 },
                    { title: "Vintage Revival", winner: "RetroStyle", participants: 156 },
                    { title: "Accessory Game Strong", winner: "StylePro", participants: 203 },
                  ].map((challenge, i) => (
                    <div key={i} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                      <div>
                        <p className="font-medium">{challenge.title}</p>
                        <p className="text-sm text-gray-500">
                          Winner: {challenge.winner} • {challenge.participants} participants
                        </p>
                      </div>
                      <Trophy className="w-5 h-5 text-yellow-500" />
                    </div>
                  ))}
                </CardContent>
              </Card>

              {/* Upcoming Challenge */}
              <Card className="md:col-span-2 bg-gradient-to-r from-purple-50 to-pink-50 border-purple-200">
                <CardContent className="p-6">
                  <div className="flex items-center gap-2 mb-2">
                    <Calendar className="w-5 h-5 text-purple-600" />
                    <span className="text-sm font-medium text-purple-600">Coming Next Week</span>
                  </div>
                  <h3 className="text-xl font-bold mb-2">Sustainable Style Challenge</h3>
                  <p className="text-gray-600">
                    Create an outfit using only thrifted or sustainable fashion items. 
                    Show us that eco-friendly can be stylish!
                  </p>
                </CardContent>
              </Card>
            </div>
          </TabsContent>
        </Tabs>

        <AuthRequiredModal
          isOpen={showAuthModal}
          onClose={closeAuthModal}
          {...authModalConfig}
        />
      </div>
    </div>
  );
}
