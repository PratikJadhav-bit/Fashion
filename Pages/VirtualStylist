import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { motion } from "framer-motion";
import {
  Sparkles,
  Camera,
  Shirt,
  ShoppingBag,
  Heart,
  TrendingUp,
  User,
  Scan
} from "lucide-react";
import AuthRequiredModal, { useAuthRequired } from "../components/auth/AuthRequiredModal";
import AIStyleEngine from "../components/styling/AIStyleEngine";
import EnhancedVirtualTryOn from "../components/tryon/EnhancedVirtualTryOn";

export default function VirtualStylist() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { user, isLoading: authLoading, isAuthenticated, showAuthModal, authModalConfig, requireAuth, closeAuthModal } = useAuthRequired();
  
  const [selectedProduct, setSelectedProduct] = React.useState(null);
  const [showTryOn, setShowTryOn] = React.useState(false);
  const [savedLooks, setSavedLooks] = React.useState([]);

  // Fetch user profile
  const { data: userProfile } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0];
    },
    enabled: !!user?.email,
  });

  // Fetch wardrobe
  const { data: wardrobeItems = [] } = useQuery({
    queryKey: ['wardrobe', user?.email],
    queryFn: () => base44.entities.WardrobeItem.filter({ user_email: user.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  // Fetch affiliate products
  const { data: affiliateProducts = [] } = useQuery({
    queryKey: ['affiliateProducts'],
    queryFn: () => base44.entities.AffiliateProduct.filter({ is_active: true }),
    initialData: [],
  });

  // Fetch product listings
  const { data: productListings = [] } = useQuery({
    queryKey: ['productListings'],
    queryFn: () => base44.entities.ProductListing.filter({ is_active: true }),
    initialData: [],
  });

  const handleTryOn = (product) => {
    if (!requireAuth({
      title: "Try On This Item",
      message: "Sign in to use virtual try-on and save your looks"
    })) return;
    
    setSelectedProduct(product);
    setShowTryOn(true);
  };

  const handleSaveLook = (lookData) => {
    setSavedLooks(prev => [...prev, lookData]);
    setShowTryOn(false);
    // In production, save to database
  };

  // Combine all products for try-on
  const allProducts = [
    ...affiliateProducts.map(p => ({ ...p, type: 'affiliate' })),
    ...productListings.map(p => ({
      ...p,
      product_name: p.product_name,
      image_url: p.design?.thumbnail_url,
      type: 'marketplace'
    }))
  ];

  if (authLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 p-4 md:p-8">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="mb-8"
        >
          <div className="flex items-center gap-3 mb-2">
            <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
              <Sparkles className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-3xl font-bold text-gray-900">AI Style Studio</h1>
              <p className="text-gray-600">Personalized recommendations & virtual try-on</p>
            </div>
          </div>
        </motion.div>

        {/* Guest View */}
        {!user && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            {/* Hero Section */}
            <Card className="bg-gradient-to-r from-purple-500 to-pink-500 text-white overflow-hidden">
              <CardContent className="p-8 md:p-12">
                <div className="max-w-2xl">
                  <h2 className="text-3xl md:text-4xl font-bold mb-4">
                    Your Personal AI Stylist
                  </h2>
                  <p className="text-lg text-white/90 mb-6">
                    Get outfit recommendations tailored to your body type, style preferences, and occasions. 
                    Try on clothes virtually before you buy.
                  </p>
                  <div className="flex flex-wrap gap-4">
                    <Button
                      onClick={() => base44.auth.redirectToLogin(createPageUrl("VirtualStylist"))}
                      size="lg"
                      className="bg-white text-purple-600 hover:bg-gray-100"
                    >
                      Get Started Free
                    </Button>
                    <Button
                      variant="outline"
                      size="lg"
                      className="border-white text-white hover:bg-white/20"
                      onClick={() => navigate(createPageUrl("Marketplace"))}
                    >
                      Browse Styles
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>

            {/* Features */}
            <div className="grid md:grid-cols-3 gap-6">
              <Card className="hover:shadow-lg transition-shadow">
                <CardContent className="p-6 text-center">
                  <div className="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mx-auto mb-4">
                    <Sparkles className="w-8 h-8 text-purple-600" />
                  </div>
                  <h3 className="font-semibold text-lg mb-2">AI Styling</h3>
                  <p className="text-gray-600 text-sm">
                    Get personalized outfit suggestions based on your body type, preferences, and occasion
                  </p>
                </CardContent>
              </Card>

              <Card className="hover:shadow-lg transition-shadow">
                <CardContent className="p-6 text-center">
                  <div className="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-4">
                    <Scan className="w-8 h-8 text-blue-600" />
                  </div>
                  <h3 className="font-semibold text-lg mb-2">Virtual Try-On</h3>
                  <p className="text-gray-600 text-sm">
                    See how clothes look on you in real-time with AR technology
                  </p>
                </CardContent>
              </Card>

              <Card className="hover:shadow-lg transition-shadow">
                <CardContent className="p-6 text-center">
                  <div className="w-16 h-16 rounded-full bg-pink-100 flex items-center justify-center mx-auto mb-4">
                    <Heart className="w-8 h-8 text-pink-600" />
                  </div>
                  <h3 className="font-semibold text-lg mb-2">Save Looks</h3>
                  <p className="text-gray-600 text-sm">
                    Save your favorite try-on looks and share them with friends
                  </p>
                </CardContent>
              </Card>
            </div>

            {/* Browse Products (Guest) */}
            <div>
              <h2 className="text-xl font-semibold mb-4">Try These Styles</h2>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {affiliateProducts.slice(0, 8).map((product) => (
                  <Card key={product.id} className="overflow-hidden group cursor-pointer hover:shadow-lg">
                    <div className="aspect-square bg-gray-100 relative">
                      {product.image_url ? (
                        <img
                          src={product.image_url}
                          alt={product.product_name}
                          className="w-full h-full object-cover group-hover:scale-105 transition-transform"
                        />
                      ) : (
                        <div className="w-full h-full flex items-center justify-center">
                          <ShoppingBag className="w-8 h-8 text-gray-300" />
                        </div>
                      )}
                      <Button
                        onClick={() => handleTryOn(product)}
                        size="sm"
                        className="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity bg-purple-500"
                      >
                        <Camera className="w-4 h-4 mr-1" />
                        Try On
                      </Button>
                    </div>
                    <CardContent className="p-3">
                      <p className="text-sm font-medium line-clamp-1">{product.product_name}</p>
                      <p className="text-purple-600 font-semibold">₹{product.price}</p>
                    </CardContent>
                  </Card>
                ))}
              </div>
            </div>
          </motion.div>
        )}

        {/* Authenticated View */}
        {user && (
          <Tabs defaultValue="styling" className="space-y-6">
            <TabsList className="w-full justify-start">
              <TabsTrigger value="styling" className="flex items-center gap-2">
                <Sparkles className="w-4 h-4" />
                AI Styling
              </TabsTrigger>
              <TabsTrigger value="tryon" className="flex items-center gap-2">
                <Camera className="w-4 h-4" />
                Try On
              </TabsTrigger>
              <TabsTrigger value="saved" className="flex items-center gap-2">
                <Heart className="w-4 h-4" />
                Saved Looks ({savedLooks.length})
              </TabsTrigger>
            </TabsList>

            {/* AI Styling Tab */}
            <TabsContent value="styling">
              <AIStyleEngine
                user={user}
                userProfile={userProfile}
                wardrobeItems={wardrobeItems}
                affiliateProducts={affiliateProducts}
              />
            </TabsContent>

            {/* Try On Tab */}
            <TabsContent value="tryon">
              <Card className="mb-6">
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Scan className="w-5 h-5 text-blue-500" />
                    Virtual Try-On
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <p className="text-gray-600 mb-4">
                    Select an item below to try it on using your camera or upload a photo
                  </p>
                </CardContent>
              </Card>

              <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
                {allProducts.slice(0, 20).map((product, index) => (
                  <motion.div
                    key={`${product.type}-${product.id}`}
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: index * 0.03 }}
                  >
                    <Card className="overflow-hidden group cursor-pointer hover:shadow-lg">
                      <div className="aspect-square bg-gray-100 relative">
                        {product.image_url ? (
                          <img
                            src={product.image_url}
                            alt={product.product_name}
                            className="w-full h-full object-cover group-hover:scale-105 transition-transform"
                          />
                        ) : (
                          <div className="w-full h-full flex items-center justify-center">
                            <Shirt className="w-8 h-8 text-gray-300" />
                          </div>
                        )}
                        <Badge className="absolute top-2 left-2 text-xs">
                          {product.type === 'marketplace' ? 'Custom' : 'Shop'}
                        </Badge>
                      </div>
                      <CardContent className="p-3">
                        <p className="text-sm font-medium line-clamp-1 mb-1">{product.product_name}</p>
                        <div className="flex items-center justify-between">
                          <p className="text-purple-600 font-semibold">₹{product.price}</p>
                          <Button
                            size="sm"
                            variant="ghost"
                            onClick={() => handleTryOn(product)}
                            className="text-blue-500 hover:text-blue-600 p-1 h-auto"
                          >
                            <Camera className="w-4 h-4" />
                          </Button>
                        </div>
                      </CardContent>
                    </Card>
                  </motion.div>
                ))}
              </div>
            </TabsContent>

            {/* Saved Looks Tab */}
            <TabsContent value="saved">
              {savedLooks.length === 0 ? (
                <Card>
                  <CardContent className="p-12 text-center">
                    <Heart className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                    <h3 className="text-lg font-semibold mb-2">No Saved Looks Yet</h3>
                    <p className="text-gray-600 mb-4">
                      Try on some items and save your favorite looks
                    </p>
                    <Button
                      onClick={() => document.querySelector('[value="tryon"]')?.click()}
                      className="bg-gradient-to-r from-purple-500 to-pink-500"
                    >
                      Start Trying On
                    </Button>
                  </CardContent>
                </Card>
              ) : (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
                  {savedLooks.map((look, index) => (
                    <Card key={index} className="overflow-hidden">
                      <div className="aspect-square bg-gray-100">
                        {look.tryOnImage && (
                          <img
                            src={look.tryOnImage}
                            alt="Saved look"
                            className="w-full h-full object-cover"
                          />
                        )}
                      </div>
                      <CardContent className="p-3">
                        <p className="text-xs text-gray-500">
                          {new Date(look.timestamp).toLocaleDateString()}
                        </p>
                      </CardContent>
                    </Card>
                  ))}
                </div>
              )}
            </TabsContent>
          </Tabs>
        )}

        {/* Virtual Try-On Modal */}
        {selectedProduct && (
          <EnhancedVirtualTryOn
            product={selectedProduct}
            isOpen={showTryOn}
            onClose={() => {
              setShowTryOn(false);
              setSelectedProduct(null);
            }}
            onSave={handleSaveLook}
          />
        )}

        <AuthRequiredModal
          isOpen={showAuthModal}
          onClose={closeAuthModal}
          {...authModalConfig}
        />
      </div>
    </div>
  );
}
