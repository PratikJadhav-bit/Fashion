import React from "react";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { base44 } from "@/api/base44Client";
import { useQuery } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { motion } from "framer-motion";
import {
  Sparkles,
  Calendar,
  Shirt,
  History,
  User,
  ArrowRight,
  TrendingUp,
  DollarSign
} from "lucide-react";
import { Skeleton } from "@/components/ui/skeleton";

export default function Dashboard() {
  const navigate = useNavigate();
  const [user, setUser] = React.useState(null);
  const [profile, setProfile] = React.useState(null);

  React.useEffect(() => {
    const loadUser = async () => {
      try {
        const currentUser = await base44.auth.me();
        setUser(currentUser);
      } catch (error) {
        // Guest mode - show limited dashboard
      }
    };
    loadUser();
  }, []);

  const { data: userProfile, isLoading: profileLoading } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      if (!user?.email) return null;
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0] || null;
    },
    enabled: !!user?.email,
  });

  const { data: wardrobeItems = [], isLoading: wardrobeLoading } = useQuery({
    queryKey: ['wardrobe', user?.email],
    queryFn: () => base44.entities.WardrobeItem.filter({ user_email: user.email }),
    enabled: !!user?.email,
    initialData: [],
  });

  const { data: outfitHistory = [], isLoading: historyLoading } = useQuery({
    queryKey: ['outfitHistory', user?.email],
    queryFn: () => base44.entities.OutfitHistory.filter({ user_email: user.email }, '-occasion_date'),
    enabled: !!user?.email,
    initialData: [],
  });

  const totalSpent = outfitHistory.reduce((sum, outfit) => sum + (outfit.total_spent || 0), 0);
  const recentOutfits = outfitHistory.slice(0, 3);

  const quickActions = [
    {
      title: "Plan an Outfit",
      description: "Get AI suggestions for your next occasion",
      icon: Calendar,
      color: "from-pink-400 to-purple-400",
      action: () => navigate(createPageUrl("OccasionPlanner"))
    },
    {
      title: "Add to Wardrobe",
      description: "Upload photos of your clothes",
      icon: Shirt,
      color: "from-purple-400 to-blue-400",
      action: () => navigate(createPageUrl("MyWardrobe"))
    },
    {
      title: "View History",
      description: "See what you've worn before",
      icon: History,
      color: "from-blue-400 to-cyan-400",
      action: () => navigate(createPageUrl("OutfitHistory"))
    }
  ];

  if (!user) {
    return (
      <div className="p-4 md:p-8 max-w-7xl mx-auto">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="text-center py-12"
        >
          <div className="w-20 h-20 rounded-full bg-gradient-to-br from-pink-100 to-purple-100 flex items-center justify-center mx-auto mb-6">
            <Sparkles className="w-10 h-10 text-purple-500" />
          </div>
          <h1 className="text-3xl font-bold text-gray-900 mb-4">
            Welcome to Fashion Hub! ✨
          </h1>
          <p className="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
            Discover personalized outfit suggestions, manage your wardrobe, and connect with a community of fashion enthusiasts.
          </p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center mb-8">
            <Button
              size="lg"
              onClick={() => base44.auth.redirectToLogin(createPageUrl("Dashboard"))}
              className="bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-600 hover:to-purple-600 text-white"
            >
              Sign In for Full Access
              <Sparkles className="ml-2 w-5 h-5" />
            </Button>
          </div>
        </motion.div>

        {/* Guest Quick Actions */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <Card 
            className="cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1"
            onClick={() => navigate(createPageUrl("Marketplace"))}
          >
            <CardContent className="p-6 text-center">
              <Sparkles className="w-10 h-10 mx-auto mb-3 text-purple-500" />
              <h3 className="font-semibold text-gray-900 mb-1">Browse Marketplace</h3>
              <p className="text-sm text-gray-600">Explore fashion products</p>
            </CardContent>
          </Card>
          <Card 
            className="cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1"
            onClick={() => navigate(createPageUrl("CommunityStyle"))}
          >
            <CardContent className="p-6 text-center">
              <User className="w-10 h-10 mx-auto mb-3 text-pink-500" />
              <h3 className="font-semibold text-gray-900 mb-1">Community Style</h3>
              <p className="text-sm text-gray-600">Get inspired by others</p>
            </CardContent>
          </Card>
          <Card 
            className="cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1"
            onClick={() => navigate(createPageUrl("Discover"))}
          >
            <CardContent className="p-6 text-center">
              <TrendingUp className="w-10 h-10 mx-auto mb-3 text-blue-500" />
              <h3 className="font-semibold text-gray-900 mb-1">Discover Trends</h3>
              <p className="text-sm text-gray-600">See what's trending</p>
            </CardContent>
          </Card>
          <Card 
            className="cursor-pointer hover:shadow-lg transition-all hover:-translate-y-1"
            onClick={() => navigate(createPageUrl("OccasionPlanner"))}
          >
            <CardContent className="p-6 text-center">
              <Calendar className="w-10 h-10 mx-auto mb-3 text-green-500" />
              <h3 className="font-semibold text-gray-900 mb-1">Plan Outfit</h3>
              <p className="text-sm text-gray-600">Get AI suggestions</p>
            </CardContent>
          </Card>
        </div>

        {/* Features Preview */}
        <h2 className="text-2xl font-bold text-gray-900 mb-4 text-center">What You Can Do</h2>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-6 text-center">
              <Calendar className="w-12 h-12 mx-auto mb-4 text-purple-500" />
              <h3 className="text-lg font-semibold text-gray-900 mb-2">Plan Outfits</h3>
              <p className="text-sm text-gray-600">Get AI-powered suggestions for any occasion</p>
            </CardContent>
          </Card>
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-6 text-center">
              <Shirt className="w-12 h-12 mx-auto mb-4 text-blue-500" />
              <h3 className="text-lg font-semibold text-gray-900 mb-2">Digital Wardrobe</h3>
              <p className="text-sm text-gray-600">Organize and manage your clothing collection</p>
            </CardContent>
          </Card>
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-6 text-center">
              <User className="w-12 h-12 mx-auto mb-4 text-pink-500" />
              <h3 className="text-lg font-semibold text-gray-900 mb-2">Style Community</h3>
              <p className="text-sm text-gray-600">Share and discover amazing outfit ideas</p>
            </CardContent>
          </Card>
        </div>
      </div>
    );
  }

  return (
    <div className="p-3 sm:p-4 md:p-8 max-w-7xl mx-auto">
      {/* Welcome Section */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="mb-6 md:mb-8"
      >
        <h1 className="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-1.5 md:mb-2">
          Welcome back, {user.full_name || "Fashionista"}! ✨
        </h1>
        <p className="text-sm sm:text-base md:text-lg text-gray-600">
          {userProfile?.profile_completed 
            ? "Ready to plan your next stunning outfit?"
            : "Let's set up your style profile to get personalized suggestions!"}
        </p>
      </motion.div>

      {/* Profile Setup Alert */}
      {!userProfile?.profile_completed && (
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
        >
          <Card className="mb-4 md:mb-6 bg-gradient-to-r from-pink-50 to-purple-50 border-pink-200">
            <CardContent className="p-4 md:p-6">
              <div className="flex items-start gap-3 md:gap-4">
                <div className="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-pink-400 to-purple-400 flex items-center justify-center flex-shrink-0">
                  <User className="w-5 h-5 md:w-6 md:h-6 text-white" />
                </div>
                <div className="flex-1 min-w-0">
                  <h3 className="text-base md:text-lg font-semibold text-gray-900 mb-1">
                    Complete Your Style Profile
                  </h3>
                  <p className="text-sm md:text-base text-gray-600 mb-3 md:mb-4">
                    Tell us about your style preferences, body type, and favorite colors to get personalized outfit suggestions!
                  </p>
                  <Button
                    onClick={() => navigate(createPageUrl("StyleProfile"))}
                    className="bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-600 hover:to-purple-600 text-white text-sm md:text-base h-9 md:h-10"
                  >
                    Set Up Profile
                    <ArrowRight className="ml-2 w-3 h-3 md:w-4 md:h-4" />
                  </Button>
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Stats Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 md:gap-6 mb-6 md:mb-8">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.2 }}
        >
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-4 md:p-6">
              <div className="flex items-center justify-between">
                <div className="min-w-0">
                  <p className="text-xs md:text-sm text-gray-500 mb-1">Wardrobe Items</p>
                  <p className="text-2xl md:text-3xl font-bold text-gray-900">
                    {wardrobeLoading ? <Skeleton className="h-6 md:h-8 w-12 md:w-16" /> : wardrobeItems.length}
                  </p>
                </div>
                <div className="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center flex-shrink-0">
                  <Shirt className="w-5 h-5 md:w-6 md:h-6 text-purple-600" />
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.3 }}
        >
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-4 md:p-6">
              <div className="flex items-center justify-between">
                <div className="min-w-0">
                  <p className="text-xs md:text-sm text-gray-500 mb-1">Outfits Planned</p>
                  <p className="text-2xl md:text-3xl font-bold text-gray-900">
                    {historyLoading ? <Skeleton className="h-6 md:h-8 w-12 md:w-16" /> : outfitHistory.length}
                  </p>
                </div>
                <div className="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center flex-shrink-0">
                  <TrendingUp className="w-5 h-5 md:w-6 md:h-6 text-blue-600" />
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.4 }}
        >
          <Card className="hover:shadow-lg transition-shadow duration-300">
            <CardContent className="p-4 md:p-6">
              <div className="flex items-center justify-between">
                <div className="min-w-0">
                  <p className="text-xs md:text-sm text-gray-500 mb-1">Total Invested</p>
                  <p className="text-2xl md:text-3xl font-bold text-gray-900">
                    {historyLoading ? <Skeleton className="h-6 md:h-8 w-16 md:w-20" /> : `$${totalSpent.toFixed(0)}`}
                  </p>
                </div>
                <div className="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center flex-shrink-0">
                  <DollarSign className="w-5 h-5 md:w-6 md:h-6 text-green-600" />
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>
      </div>

      {/* Quick Actions */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ delay: 0.5 }}
        className="mb-6 md:mb-8"
      >
        <h2 className="text-xl md:text-2xl font-bold text-gray-900 mb-3 md:mb-4">Quick Actions</h2>
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 md:gap-6">
          {quickActions.map((action, index) => (
            <Card
              key={action.title}
              className="group cursor-pointer hover:shadow-xl transition-all duration-300 active:scale-95 md:hover:-translate-y-1"
              onClick={action.action}
            >
              <CardContent className="p-4 md:p-6">
                <div className={`w-12 h-12 md:w-14 md:h-14 rounded-xl md:rounded-2xl bg-gradient-to-br ${action.color} flex items-center justify-center mb-3 md:mb-4 group-hover:scale-110 transition-transform duration-300 shadow-lg`}>
                  <action.icon className="w-6 h-6 md:w-7 md:h-7 text-white" />
                </div>
                <h3 className="text-base md:text-lg font-semibold text-gray-900 mb-1.5 md:mb-2">
                  {action.title}
                </h3>
                <p className="text-gray-600 text-xs md:text-sm mb-3 md:mb-4">
                  {action.description}
                </p>
                <div className="flex items-center text-pink-600 font-medium text-xs md:text-sm group-hover:gap-2 transition-all">
                  Get Started
                  <ArrowRight className="w-3 h-3 md:w-4 md:h-4 ml-1 group-hover:translate-x-1 transition-transform" />
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      </motion.div>

      {/* Recent Outfits */}
      {recentOutfits.length > 0 && (
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.6 }}
        >
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-2xl font-bold text-gray-900">Recent Outfits</h2>
            <Button
              variant="ghost"
              onClick={() => navigate(createPageUrl("OutfitHistory"))}
              className="text-pink-600 hover:text-pink-700"
            >
              View All
              <ArrowRight className="ml-2 w-4 h-4" />
            </Button>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
            {recentOutfits.map((outfit) => (
              <Card key={outfit.id} className="hover:shadow-lg transition-shadow duration-300">
                <CardHeader>
                  <CardTitle className="text-lg">{outfit.occasion_name || outfit.occasion_type}</CardTitle>
                </CardHeader>
                <CardContent>
                  <p className="text-sm text-gray-500 mb-2">
                    {new Date(outfit.occasion_date).toLocaleDateString('en-US', { 
                      month: 'long', 
                      day: 'numeric', 
                      year: 'numeric' 
                    })}
                  </p>
                  {outfit.outfit_description && (
                    <p className="text-sm text-gray-700 line-clamp-2">
                      {outfit.outfit_description}
                    </p>
                  )}
                  {outfit.total_spent > 0 && (
                    <p className="text-sm font-medium text-green-600 mt-2">
                      ${outfit.total_spent.toFixed(2)} spent
                    </p>
                  )}
                </CardContent>
              </Card>
            ))}
          </div>
        </motion.div>
      )}
    </div>
  );
}