import React from "react";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { base44 } from "@/api/base44Client";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";
import { motion, AnimatePresence, useScroll, useTransform } from "framer-motion";
import {
  Sparkles,
  Camera,
  ShoppingBag,
  Heart,
  User,
  Home as HomeIcon,
  Grid3x3,
  ChevronRight,
  ArrowRight,
  Clock,
  TrendingUp,
  Zap,
  Star,
  LogIn
} from "lucide-react";

export default function Home() {
  const navigate = useNavigate();
  const [user, setUser] = React.useState(null);
  const [loading, setLoading] = React.useState(true);
  const [currentLook, setCurrentLook] = React.useState(0);
  const [expandedCategory, setExpandedCategory] = React.useState(null);
  const [timeLeft, setTimeLeft] = React.useState({ hours: 12, minutes: 34, seconds: 56 });
  
  const { scrollY } = useScroll();
  const heroOpacity = useTransform(scrollY, [0, 300], [1, 0]);
  const heroScale = useTransform(scrollY, [0, 300], [1, 0.95]);

  React.useEffect(() => {
    const checkAuth = async () => {
      try {
        const currentUser = await base44.auth.me();
        setUser(currentUser);
      } catch (error) {
        setUser(null);
      }
      setLoading(false);
    };
    checkAuth();
  }, []);

  // Countdown timer
  React.useEffect(() => {
    const timer = setInterval(() => {
      setTimeLeft(prev => {
        let { hours, minutes, seconds } = prev;
        if (seconds > 0) seconds--;
        else if (minutes > 0) { minutes--; seconds = 59; }
        else if (hours > 0) { hours--; minutes = 59; seconds = 59; }
        return { hours, minutes, seconds };
      });
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const fashionLooks = [
    {
      id: 1,
      title: "Winter Elegance",
      subtitle: "Cozy & Chic",
      image: "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=800&q=80",
      color: "from-blue-500 to-purple-600",
      tag: "Trending"
    },
    {
      id: 2,
      title: "Street Style",
      subtitle: "Urban Cool",
      image: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80",
      color: "from-pink-500 to-orange-500",
      tag: "Hot"
    },
    {
      id: 3,
      title: "Date Night",
      subtitle: "Romantic Vibes",
      image: "https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?w=800&q=80",
      color: "from-purple-500 to-pink-500",
      tag: "New"
    }
  ];

  // Auto-swipe carousel
  React.useEffect(() => {
    const interval = setInterval(() => {
      setCurrentLook(prev => (prev + 1) % fashionLooks.length);
    }, 4000);
    return () => clearInterval(interval);
  }, [fashionLooks.length]);

  const categories = [
    { id: 1, name: "Winter Fits", icon: "🧥", color: "bg-blue-100", count: 24 },
    { id: 2, name: "Trending Now", icon: "🔥", color: "bg-orange-100", count: 18 },
    { id: 3, name: "Date Night", icon: "💕", color: "bg-pink-100", count: 15 },
    { id: 4, name: "Gym Wear", icon: "💪", color: "bg-green-100", count: 12 }
  ];

  const greeting = () => {
    const hour = new Date().getHours();
    if (hour < 12) return "Good Morning";
    if (hour < 18) return "Good Afternoon";
    return "Good Evening";
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 to-gray-800">
        <motion.div
          animate={{ rotate: 360 }}
          transition={{ duration: 1, repeat: Infinity, ease: "linear" }}
          className="w-12 h-12 border-4 border-white/20 border-t-white rounded-full"
        />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 pb-20">
      {/* Hero Carousel - Full Screen */}
      <motion.div 
        className="relative h-screen overflow-hidden"
        style={{ opacity: heroOpacity, scale: heroScale }}
      >
        <AnimatePresence mode="wait">
          <motion.div
            key={currentLook}
            initial={{ opacity: 0, x: 300 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -300 }}
            transition={{ duration: 0.7, ease: "easeInOut" }}
            className="absolute inset-0"
          >
            {/* Background Image with Parallax */}
            <div className="absolute inset-0 overflow-hidden">
              <motion.div
                initial={{ scale: 1.1 }}
                animate={{ scale: 1 }}
                transition={{ duration: 0.7 }}
                className="w-full h-full"
              >
                <img
                  src={fashionLooks[currentLook].image}
                  alt={fashionLooks[currentLook].title}
                  className="w-full h-full object-cover"
                />
                <div className={`absolute inset-0 bg-gradient-to-t ${fashionLooks[currentLook].color} opacity-70`} />
              </motion.div>
            </div>

            {/* Content Overlay */}
            <div className="relative h-full flex flex-col justify-end p-6 pb-24">
              <motion.div
                initial={{ y: 50, opacity: 0 }}
                animate={{ y: 0, opacity: 1 }}
                transition={{ delay: 0.3, duration: 0.6 }}
              >
                <Badge className="mb-4 bg-white/20 backdrop-blur-md text-white border-white/30">
                  <Zap className="w-3 h-3 mr-1" />
                  {fashionLooks[currentLook].tag}
                </Badge>
                <h1 className="text-5xl font-bold text-white mb-2 drop-shadow-2xl">
                  {fashionLooks[currentLook].title}
                </h1>
                <p className="text-xl text-white/90 mb-6 drop-shadow-lg">
                  {fashionLooks[currentLook].subtitle}
                </p>
                
                <div className="flex gap-3 flex-wrap">
                  {!user && (
                    <motion.div whileTap={{ scale: 0.95 }}>
                      <Button
                        onClick={() => base44.auth.redirectToLogin(createPageUrl("Home"))}
                        size="lg"
                        className="bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white shadow-2xl rounded-full px-8"
                      >
                        <LogIn className="w-5 h-5 mr-2" />
                        Sign Up / Log In
                      </Button>
                    </motion.div>
                  )}
                  <motion.div whileTap={{ scale: 0.95 }}>
                    <Button
                      onClick={() => navigate(createPageUrl("VirtualStylist"))}
                      size="lg"
                      className="bg-white text-gray-900 hover:bg-white/90 shadow-2xl rounded-full px-8"
                    >
                      <Camera className="w-5 h-5 mr-2" />
                      Try It On
                    </Button>
                  </motion.div>
                  <motion.div whileTap={{ scale: 0.95 }}>
                    <Button
                      onClick={() => navigate(createPageUrl("Marketplace"))}
                      size="lg"
                      variant="outline"
                      className="border-2 border-white text-white hover:bg-white/20 backdrop-blur-md rounded-full"
                    >
                      Shop Look
                      <ArrowRight className="w-5 h-5 ml-2" />
                    </Button>
                  </motion.div>
                </div>
              </motion.div>

              {/* Carousel Indicators */}
              <div className="flex gap-2 mt-8 justify-center">
                {fashionLooks.map((_, index) => (
                  <motion.button
                    key={index}
                    onClick={() => setCurrentLook(index)}
                    className={`h-1 rounded-full transition-all ${
                      index === currentLook ? "w-8 bg-white" : "w-1 bg-white/40"
                    }`}
                    whileTap={{ scale: 0.9 }}
                  />
                ))}
              </div>
            </div>
          </motion.div>
        </AnimatePresence>

        {/* Swipe Indicator */}
        <motion.div
          initial={{ opacity: 1, y: 0 }}
          animate={{ opacity: [1, 0.5, 1], y: [0, 10, 0] }}
          transition={{ duration: 2, repeat: Infinity }}
          className="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white/60 text-sm"
        >
          Swipe for more
        </motion.div>
      </motion.div>

      {/* Personalized Greeting */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        className="px-6 py-8 -mt-16 relative z-10"
      >
        <Card className="bg-white/80 backdrop-blur-lg border-0 shadow-2xl">
          <CardContent className="p-6">
            <h2 className="text-2xl font-bold mb-1">
              {greeting()}{user ? `, ${user.full_name?.split(' ')[0] || 'Fashionista'}` : ''}! 👋
            </h2>
            <p className="text-gray-600">Discover today's trending styles</p>
          </CardContent>
        </Card>
      </motion.div>

      {/* Daily Drop with Countdown */}
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        className="px-6 py-4"
      >
        <Card className="bg-gradient-to-r from-purple-500 to-pink-500 border-0 shadow-xl overflow-hidden">
          <CardContent className="p-6 relative">
            <motion.div
              animate={{ rotate: 360 }}
              transition={{ duration: 20, repeat: Infinity, ease: "linear" }}
              className="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full"
            />
            <div className="relative z-10">
              <Badge className="mb-2 bg-white/20 text-white border-0">
                <Star className="w-3 h-3 mr-1" />
                Limited Time
              </Badge>
              <h3 className="text-2xl font-bold text-white mb-2">Daily Drop 🎁</h3>
              <p className="text-white/90 mb-4 text-sm">Exclusive styles ending soon</p>
              
              <div className="flex gap-3 mb-4">
                {[
                  { label: 'Hours', value: timeLeft.hours },
                  { label: 'Mins', value: timeLeft.minutes },
                  { label: 'Secs', value: timeLeft.seconds }
                ].map((item) => (
                  <div key={item.label} className="flex-1 bg-white/20 backdrop-blur-md rounded-xl p-3 text-center">
                    <div className="text-2xl font-bold text-white">{String(item.value).padStart(2, '0')}</div>
                    <div className="text-xs text-white/80">{item.label}</div>
                  </div>
                ))}
              </div>

              <motion.div whileTap={{ scale: 0.95 }}>
                <Button
                  onClick={() => navigate(createPageUrl("Marketplace"))}
                  className="w-full bg-white text-purple-600 hover:bg-gray-100"
                >
                  Shop Now
                  <ArrowRight className="w-4 h-4 ml-2" />
                </Button>
              </motion.div>
            </div>
          </CardContent>
        </Card>
      </motion.div>

      {/* Dynamic Category Tiles */}
      <div className="px-6 py-4">
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-xl font-bold">Shop by Style</h3>
          <Button
            variant="ghost"
            size="sm"
            onClick={() => navigate(createPageUrl("Marketplace"))}
            className="text-purple-600"
          >
            See All <ChevronRight className="w-4 h-4 ml-1" />
          </Button>
        </div>

        <div className="grid grid-cols-2 gap-3">
          {categories.map((category, index) => (
            <motion.div
              key={category.id}
              initial={{ opacity: 0, scale: 0.9 }}
              whileInView={{ opacity: 1, scale: 1 }}
              viewport={{ once: true }}
              transition={{ delay: index * 0.1 }}
              whileTap={{ scale: 0.97 }}
            >
              <Card
                onClick={() => {
                  if (expandedCategory === category.id) {
                    setExpandedCategory(null);
                  } else {
                    setExpandedCategory(category.id);
                  }
                }}
                className={`cursor-pointer transition-all duration-300 border-0 shadow-lg ${
                  expandedCategory === category.id ? 'ring-2 ring-purple-500' : ''
                }`}
              >
                <CardContent className="p-6">
                  <div className={`w-12 h-12 ${category.color} rounded-2xl flex items-center justify-center text-2xl mb-3`}>
                    {category.icon}
                  </div>
                  <h4 className="font-semibold mb-1">{category.name}</h4>
                  <p className="text-sm text-gray-500">{category.count} items</p>
                  
                  <AnimatePresence>
                    {expandedCategory === category.id && (
                      <motion.div
                        initial={{ height: 0, opacity: 0 }}
                        animate={{ height: 'auto', opacity: 1 }}
                        exit={{ height: 0, opacity: 0 }}
                        transition={{ duration: 0.3 }}
                        className="mt-3 pt-3 border-t"
                      >
                        <Button
                          size="sm"
                          onClick={(e) => {
                            e.stopPropagation();
                            navigate(createPageUrl("Marketplace"));
                          }}
                          className="w-full bg-purple-600"
                        >
                          Explore
                        </Button>
                      </motion.div>
                    )}
                  </AnimatePresence>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </div>
      </div>

      {/* Quick Actions */}
      <div className="px-6 py-4">
        <h3 className="text-xl font-bold mb-4">Quick Actions</h3>
        <div className="grid grid-cols-2 gap-3">
          {[
            { title: "AI Stylist", icon: Sparkles, color: "from-purple-500 to-pink-500", page: "VirtualStylist" },
            { title: "Try On AR", icon: Camera, color: "from-blue-500 to-cyan-500", page: "VirtualStylist" }
          ].map((action, index) => (
            <motion.div
              key={action.title}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ delay: index * 0.1 }}
              whileTap={{ scale: 0.95 }}
            >
              <Card
                onClick={() => navigate(createPageUrl(action.page))}
                className={`cursor-pointer bg-gradient-to-br ${action.color} border-0 text-white shadow-xl hover:shadow-2xl transition-all`}
              >
                <CardContent className="p-6 text-center">
                  <action.icon className="w-8 h-8 mx-auto mb-2" />
                  <p className="font-semibold">{action.title}</p>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </div>
      </div>

      {/* Sticky Bottom Navigation */}
      <motion.div
        initial={{ y: 100 }}
        animate={{ y: 0 }}
        transition={{ delay: 0.5, type: "spring", stiffness: 100 }}
        className="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-xl border-t border-gray-200 px-6 py-3 z-50 shadow-2xl"
      >
        <div className="flex justify-around items-center max-w-md mx-auto">
          {[
            { icon: HomeIcon, label: "Home", page: "Home", active: true },
            { icon: Grid3x3, label: "Browse", page: "Marketplace" },
            { icon: Heart, label: "Wishlist", page: "ForYou" },
            { icon: User, label: "Profile", page: user ? "Dashboard" : "Home" }
          ].map((item) => (
            <motion.button
              key={item.label}
              onClick={() => navigate(createPageUrl(item.page))}
              className={`flex flex-col items-center gap-1 px-4 py-2 rounded-xl transition-all ${
                item.active ? 'text-purple-600' : 'text-gray-500'
              }`}
              whileTap={{ scale: 0.9 }}
            >
              <item.icon className={`w-6 h-6 ${item.active ? 'fill-purple-600' : ''}`} />
              <span className="text-xs font-medium">{item.label}</span>
            </motion.button>
          ))}
        </div>
      </motion.div>
    </div>
  );
}
