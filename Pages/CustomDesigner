    const initialDesign = {
      garment_type: garmentId,
      fit_shape: "regular_fit",
      size: "M",
      material: "cotton_ringspun",
      base_color: "#FFFFFF",
      graphics: [],
      estimated_price: 29.99,
      status: "draft"
