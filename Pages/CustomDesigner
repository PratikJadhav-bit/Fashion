3. Perfect base color (provide hex code)
4. Design elements to add (text, graphics, patterns)
5. Overall style direction

Format as JSON:
{
  "garment_type": "...",
  "material": "...",
  "base_color": "#...",
  "reasoning": "..."
}`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt: prompt,
        add_context_from_internet: true,
        response_json_schema: {
          type: "object",
          properties: {
            garment_type: { type: "string" },
            material: { type: "string" },
            base_color: { type: "string" },
            reasoning: { type: "string" }
          }
        }
      });

      // Create design with AI suggestions
      const aiDesign = {
        garment_type: result.garment_type || "tshirt_crewneck",
        fit_shape: "regular_fit",
        size: "M",
        material: result.material || "cotton_ringspun",
        base_color: result.base_color || "#FFFFFF",
        graphics: [],
        estimated_price: 29.99,
        status: "draft",
        ai_generated: true,
        ai_reasoning: result.reasoning
      };

      sessionStorage.setItem("currentDesign", JSON.stringify(aiDesign));
      navigate(createPageUrl("DesignEditor"));
    } catch (error) {
      console.error("Error generating AI design:", error);
      alert("Failed to generate AI design. Please try again.");
    }
    setIsGenerating(false);
  };

  if (!user) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 p-4 md:p-8">
