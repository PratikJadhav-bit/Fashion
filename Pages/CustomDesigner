  const generateAIDesign = async () => {
    if (!aiPrompt.trim()) return;

    setIsGenerating(true);
    try {
      const prompt = `Based on this design request: "${aiPrompt}"
      
Suggest the perfect garment setup with these details:
1. Best garment type (from: tshirt_crewneck, tshirt_vneck, hoodie_pullover, hoodie_zipup, sweatshirt, tank_top, pants_joggers, pants_denim, pants_chinos, shorts, jacket_bomber, jacket_denim)
