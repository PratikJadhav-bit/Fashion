        base44.auth.redirectToLogin(createPageUrl("CustomDesigner"));
      }
    };
    loadUser();
  }, []);

  const garmentTypes = [
    {
      category: "Tops",
      items: [
        { id: "tshirt_crewneck", name: "T-Shirt (Crewneck)", icon: "👕", image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400" },
        { id: "tshirt_vneck", name: "T-Shirt (V-Neck)", icon: "👕", image: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?w=400" },
        { id: "hoodie_pullover", name: "Hoodie (Pullover)", icon: "🧥", image: "https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=400" },
