        { id: "sweatshirt", name: "Sweatshirt", icon: "👔", image: "https://images.unsplash.com/photo-1578587018452-892bacefd3f2?w=400" },
        { id: "tank_top", name: "Tank Top", icon: "👚", image: "https://images.unsplash.com/photo-1622445275463-afa2ab738c34?w=400" }
