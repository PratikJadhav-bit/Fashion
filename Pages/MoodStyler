import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { motion } from "framer-motion";
import {
  Sparkles,
  Heart,
  Zap,
  Sun,
  Moon,
  Cloud,
  Flame,
  Loader2,
  Upload,
  Camera
} from "lucide-react";
import AuthRequiredModal, { useAuthRequired } from "../components/auth/AuthRequiredModal";

const moodOptions = [
  { id: "confident", label: "Confident", icon: Zap, color: "from-orange-400 to-red-500", suggestion: "Bold colors, structured pieces, power suits" },
  { id: "romantic", label: "Romantic", icon: Heart, color: "from-pink-400 to-rose-500", suggestion: "Soft fabrics, florals, pastels" },
  { id: "calm", label: "Calm", icon: Cloud, color: "from-blue-300 to-cyan-400", suggestion: "Neutral tones, comfortable fits, loungewear" },
  { id: "bold", label: "Bold", icon: Flame, color: "from-yellow-400 to-orange-500", suggestion: "Neon streetwear, statement pieces" },
  { id: "mysterious", label: "Mysterious", icon: Moon, color: "from-purple-500 to-indigo-600", suggestion: "Dark tones, layered looks, edgy accessories" },
  { id: "cheerful", label: "Cheerful", icon: Sun, color: "from-yellow-300 to-amber-400", suggestion: "Bright colors, fun prints, playful styles" },
];

export default function MoodStyler() {
  const navigate = useNavigate();
  const { user, isAuthenticated, showAuthModal, authModalConfig, requireAuth, closeAuthModal } = useAuthRequired();
  const [selectedMood, setSelectedMood] = React.useState(null);
  const [customMood, setCustomMood] = React.useState("");
  const [selfieUrl, setSelfieUrl] = React.useState(null);
  const [isAnalyzing, setIsAnalyzing] = React.useState(false);
  const [suggestions, setSuggestions] = React.useState(null);
  const fileInputRef = React.useRef(null);

  const { data: userProfile } = useQuery({
    queryKey: ['userProfile', user?.email],
    queryFn: async () => {
      const profiles = await base44.entities.UserProfile.filter({ user_email: user.email });
      return profiles[0];
    },
    enabled: !!user?.email,
  });

  const { data: affiliateProducts = [] } = useQuery({
    queryKey: ['affiliateProducts'],
    queryFn: () => base44.entities.AffiliateProduct.filter({ is_active: true }),
    initialData: [],
  });

  const handleSelfieUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (!requireAuth({
      title: "Upload your selfie",
      message: "Sign in to upload photos and get personalized AI style analysis."
    })) return;

    setIsAnalyzing(true);
    try {
      const { file_url } = await base44.integrations.Core.UploadFile({ file });
      setSelfieUrl(file_url);

      // Analyze selfie for mood
      const analysis = await base44.integrations.Core.InvokeLLM({
        prompt: `Analyze this selfie and determine the person's apparent mood/emotional state. 
Consider facial expression, body language, and overall vibe.
Return the detected mood and style suggestions.`,
        file_urls: [file_url],
        response_json_schema: {
          type: "object",
          properties: {
            detected_mood: { type: "string" },
            confidence: { type: "number" },
            style_suggestions: { type: "array", items: { type: "string" } },
            color_palette: { type: "array", items: { type: "string" } }
          }
        }
      });

      await generateOutfitSuggestions(analysis.detected_mood, analysis);
    } catch (error) {
      console.error("Error analyzing selfie:", error);
    }
    setIsAnalyzing(false);
  };

  const generateOutfitSuggestions = async (mood, selfieAnalysis = null) => {
    setIsAnalyzing(true);
    try {
      const prompt = `Generate outfit suggestions for someone feeling "${mood}".
${selfieAnalysis ? `Selfie analysis: ${JSON.stringify(selfieAnalysis)}` : ""}
${userProfile ? `User preferences: ${JSON.stringify(userProfile)}` : ""}

Provide:
1. Overall style direction for this mood
2. 4-5 specific outfit ideas with descriptions
3. Key pieces to look for
4. Color recommendations
5. Accessories that enhance this mood`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt,
        add_context_from_internet: true,
        response_json_schema: {
          type: "object",
          properties: {
            mood_interpretation: { type: "string" },
            style_direction: { type: "string" },
            outfit_ideas: { type: "array", items: { type: "string" } },
            key_pieces: { type: "array", items: { type: "string" } },
            colors: { type: "array", items: { type: "string" } },
            accessories: { type: "array", items: { type: "string" } }
          }
        }
      });

      // Match affiliate products
      const matchedProducts = affiliateProducts.filter(p => 
        result.key_pieces?.some(piece => 
          p.product_name.toLowerCase().includes(piece.toLowerCase().split(' ')[0]) ||
          p.category.toLowerCase().includes(piece.toLowerCase())
        ) ||
        result.colors?.some(color => 
          p.color?.toLowerCase().includes(color.toLowerCase())
        )
      ).slice(0, 8);

      setSuggestions({
        ...result,
        mood,
        matchedProducts
      });
    } catch (error) {
      console.error("Error generating suggestions:", error);
    }
    setIsAnalyzing(false);
  };

  const handleMoodSelect = (mood) => {
    setSelectedMood(mood);
    generateOutfitSuggestions(mood.label);
  };

  const handleCustomMoodSubmit = () => {
    if (customMood.trim()) {
      generateOutfitSuggestions(customMood);
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 p-4 md:p-8">
      <div className="max-w-5xl mx-auto">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="text-center mb-10"
        >
          <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 backdrop-blur-sm border border-purple-200 mb-6">
            <Sparkles className="w-4 h-4 text-purple-500" />
            <span className="text-sm font-medium text-gray-700">Mood-to-Style Translator</span>
          </div>
          
          <h1 className="text-4xl md:text-5xl font-bold mb-4">
            <span className="bg-gradient-to-r from-purple-600 via-pink-500 to-orange-500 bg-clip-text text-transparent">
              How Are You Feeling?
            </span>
          </h1>
          <p className="text-lg text-gray-600 max-w-2xl mx-auto">
            Your mood shapes your style. Tell us how you feel, and we'll curate the perfect outfit to match your emotional state.
          </p>
        </motion.div>

        {/* Selfie Upload */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
          className="mb-8"
        >
          <Card className="bg-gradient-to-r from-purple-100 to-pink-100 border-purple-200">
            <CardContent className="p-6 text-center">
              <Camera className="w-12 h-12 mx-auto mb-4 text-purple-600" />
              <h3 className="text-lg font-semibold mb-2">Upload a Selfie</h3>
              <p className="text-sm text-gray-600 mb-4">
                Let AI detect your mood from your expression
              </p>
              <Button
                onClick={() => fileInputRef.current?.click()}
                disabled={isAnalyzing}
                className="bg-gradient-to-r from-purple-500 to-pink-500"
              >
                <Upload className="w-4 h-4 mr-2" />
                {isAnalyzing ? "Analyzing..." : "Upload Selfie"}
              </Button>
              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                onChange={handleSelfieUpload}
                className="hidden"
              />
              {selfieUrl && (
                <div className="mt-4">
                  <img src={selfieUrl} alt="Your selfie" className="w-24 h-24 rounded-full mx-auto object-cover border-4 border-white shadow-lg" />
                </div>
              )}
            </CardContent>
          </Card>
        </motion.div>

        {/* Mood Selection */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.2 }}
          className="mb-8"
        >
          <h2 className="text-xl font-semibold text-center mb-6">Or select your mood</h2>
          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            {moodOptions.map((mood) => (
              <motion.div
                key={mood.id}
                whileHover={{ scale: 1.03 }}
                whileTap={{ scale: 0.98 }}
              >
                <Card
                  className={`cursor-pointer transition-all ${
                    selectedMood?.id === mood.id ? "ring-2 ring-purple-500 shadow-lg" : "hover:shadow-md"
                  }`}
                  onClick={() => handleMoodSelect(mood)}
                >
                  <CardContent className="p-6 text-center">
                    <div className={`w-14 h-14 rounded-full bg-gradient-to-r ${mood.color} flex items-center justify-center mx-auto mb-3`}>
                      <mood.icon className="w-7 h-7 text-white" />
                    </div>
                    <h3 className="font-semibold text-lg mb-1">{mood.label}</h3>
                    <p className="text-xs text-gray-500">{mood.suggestion}</p>
                  </CardContent>
                </Card>
              </motion.div>
            ))}
          </div>
        </motion.div>

        {/* Custom Mood Input */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.3 }}
          className="mb-8"
        >
          <Card>
            <CardContent className="p-6">
              <h3 className="font-semibold mb-3">Describe your mood</h3>
              <div className="flex gap-3">
                <Input
                  value={customMood}
                  onChange={(e) => setCustomMood(e.target.value)}
                  placeholder="e.g., adventurous, cozy, powerful, dreamy..."
                  onKeyPress={(e) => e.key === 'Enter' && handleCustomMoodSubmit()}
                />
                <Button
                  onClick={handleCustomMoodSubmit}
                  disabled={!customMood.trim() || isAnalyzing}
                  className="bg-gradient-to-r from-purple-500 to-pink-500"
                >
                  {isAnalyzing ? <Loader2 className="w-4 h-4 animate-spin" /> : <Sparkles className="w-4 h-4" />}
                </Button>
              </div>
            </CardContent>
          </Card>
        </motion.div>

        {/* Results */}
        {isAnalyzing && (
          <div className="text-center py-12">
            <Loader2 className="w-12 h-12 animate-spin text-purple-500 mx-auto mb-4" />
            <p className="text-gray-600">Translating your mood into style...</p>
          </div>
        )}

        {suggestions && !isAnalyzing && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-6"
          >
            <Card className="bg-gradient-to-r from-purple-50 to-pink-50 border-purple-200">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Sparkles className="w-5 h-5 text-purple-600" />
                  Style for "{suggestions.mood}" Mood
                </CardTitle>
              </CardHeader>
              <CardContent>
                <p className="text-gray-700 mb-4">{suggestions.style_direction}</p>
                
                {suggestions.colors?.length > 0 && (
                  <div className="mb-4">
                    <h4 className="font-medium text-sm mb-2">Recommended Colors</h4>
                    <div className="flex flex-wrap gap-2">
                      {suggestions.colors.map((color, i) => (
                        <Badge key={i} variant="outline" className="capitalize">{color}</Badge>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>

            {suggestions.outfit_ideas?.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle>Outfit Ideas</CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="space-y-3">
                    {suggestions.outfit_ideas.map((idea, i) => (
                      <div key={i} className="bg-gray-50 rounded-lg p-4">
                        <p className="text-gray-700">{idea}</p>
                      </div>
                    ))}
                  </div>
                </CardContent>
              </Card>
            )}

            {suggestions.matchedProducts?.length > 0 && (
              <Card>
                <CardHeader>
                  <CardTitle>Shop the Look</CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {suggestions.matchedProducts.map((product) => (
                      <a
                        key={product.id}
                        href={product.product_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="group"
                      >
                        <div className="aspect-square bg-gray-100 rounded-lg overflow-hidden mb-2">
                          {product.image_url ? (
                            <img src={product.image_url} alt={product.product_name} className="w-full h-full object-cover group-hover:scale-110 transition-transform" />
                          ) : (
                            <div className="w-full h-full flex items-center justify-center text-gray-400">No image</div>
                          )}
                        </div>
                        <p className="text-sm font-medium line-clamp-2">{product.product_name}</p>
                        <p className="text-sm text-purple-600 font-semibold">₹{product.price}</p>
                      </a>
                    ))}
                  </div>
                </CardContent>
              </Card>
            )}

            <div className="text-center">
              <Button
                onClick={() => navigate(createPageUrl("OccasionPlanner"))}
                className="bg-gradient-to-r from-purple-500 to-pink-500"
              >
                Plan a Complete Outfit
              </Button>
            </div>
          </motion.div>
        )}

        <AuthRequiredModal
          isOpen={showAuthModal}
          onClose={closeAuthModal}
          {...authModalConfig}
        />
      </div>
    </div>
  );
}
