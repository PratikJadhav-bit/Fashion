{
  "name": "ProductOrder",
  "type": "object",
  "properties": {
    "product_listing_id": {
      "type": "string",
      "description": "ID of the product listing"
    },
    "design_id": {
      "type": "string",
      "description": "ID of the design"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email of the buyer"
    },
    "buyer_name": {
      "type": "string",
      "description": "Name of the buyer"
    },
    "selected_size": {
      "type": "string",
      "description": "Selected size"
    },
    "selected_material": {
      "type": "string",
      "description": "Selected material"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Order quantity"
    },
    "total_price": {
      "type": "number",
      "description": "Total price"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "address_line1": {
          "type": "string"
        },
        "address_line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "order_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "printing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Order status"
    },
    "tracking_number": {
      "type": "string",
      "description": "Shipping tracking number"
    },
    "order_notes": {
      "type": "string",
      "description": "Special instructions or notes"
    }
  },
  "required": [
    "design_id",
    "buyer_email",
    "selected_size",
    "total_price",
    "shipping_address"
  ]
}