import React, { useRef, useState, useEffect, useCallback } from "react";
import { base44 } from "@/api/base44Client";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Slider } from "@/components/ui/slider";
import {
  Camera,
  Upload,
  Scan,
  RotateCcw,
  ZoomIn,
  ZoomOut,
  Move,
  Download,
  Share2,
  Loader2,
  RefreshCw,
  Sparkles,
  X,
  Check,
  FlipHorizontal,
  SunMedium
} from "lucide-react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { motion, AnimatePresence } from "framer-motion";

export default function EnhancedVirtualTryOn({ product, isOpen, onClose, onSave }) {
  const videoRef = useRef(null);
  const canvasRef = useRef(null);
  const overlayCanvasRef = useRef(null);
  const fileInputRef = useRef(null);

  const [stream, setStream] = useState(null);
  const [mode, setMode] = useState(null); // 'camera', 'upload', 'ar'
  const [userPhoto, setUserPhoto] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [bodyDetected, setBodyDetected] = useState(false);
  const [tryOnResult, setTryOnResult] = useState(null);

  // Transform controls
  const [scale, setScale] = useState([1]);
  const [rotation, setRotation] = useState([0]);
  const [position, setPosition] = useState({ x: 50, y: 40 });
  const [brightness, setBrightness] = useState([100]);
  const [isFlipped, setIsFlipped] = useState(false);

  // Camera settings
  const [facingMode, setFacingMode] = useState("user");

  const startCamera = async (arEnabled = false) => {
    try {
      const mediaStream = await navigator.mediaDevices.getUserMedia({
        video: { 
          facingMode: facingMode,
          width: { ideal: 1280 },
          height: { ideal: 720 }
        }
      });
      
      if (videoRef.current) {
        videoRef.current.srcObject = mediaStream;
      }
      setStream(mediaStream);
      setMode(arEnabled ? 'ar' : 'camera');
      
      if (arEnabled) {
        startBodyTracking();
      }
    } catch (error) {
      console.error("Camera access error:", error);
      alert("Unable to access camera. Please check permissions.");
    }
  };

  const stopCamera = useCallback(() => {
    if (stream) {
      stream.getTracks().forEach(track => track.stop());
      setStream(null);
    }
  }, [stream]);

  const switchCamera = async () => {
    stopCamera();
    setFacingMode(prev => prev === "user" ? "environment" : "user");
    setTimeout(() => startCamera(mode === 'ar'), 100);
  };

  const startBodyTracking = () => {
    // Simulated body detection - in production, use TensorFlow.js PoseNet/MoveNet
    const detectInterval = setInterval(() => {
      if (videoRef.current?.readyState === 4) {
        setBodyDetected(true);
        renderAROverlay();
      }
    }, 50);
    
    return () => clearInterval(detectInterval);
  };

  const renderAROverlay = useCallback(() => {
    if (!overlayCanvasRef.current || !videoRef.current || !product) return;
    
    const canvas = overlayCanvasRef.current;
    const video = videoRef.current;
    const ctx = canvas.getContext('2d');
    
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;
    
    // Draw video frame
    ctx.save();
    if (facingMode === "user") {
      ctx.scale(-1, 1);
      ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
    } else {
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    }
    ctx.restore();
    
    // Calculate garment position and size
    const garmentWidth = canvas.width * 0.4 * scale[0];
    const garmentHeight = canvas.height * 0.5 * scale[0];
    const garmentX = (position.x / 100) * canvas.width - garmentWidth / 2;
    const garmentY = (position.y / 100) * canvas.height - garmentHeight / 4;
    
    ctx.save();
    ctx.translate(garmentX + garmentWidth / 2, garmentY + garmentHeight / 2);
    ctx.rotate((rotation[0] * Math.PI) / 180);
    if (isFlipped) ctx.scale(-1, 1);
    ctx.translate(-garmentWidth / 2, -garmentHeight / 2);
    
    // Apply brightness filter
    ctx.filter = `brightness(${brightness[0]}%)`;
    
    // Draw product image or placeholder
    if (product.image_url) {
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.src = product.image_url;
      
      if (img.complete) {
        ctx.globalAlpha = 0.85;
        ctx.drawImage(img, 0, 0, garmentWidth, garmentHeight);
      }
    } else {
      // Fallback colored shape
      ctx.globalAlpha = 0.8;
      ctx.fillStyle = product.color || '#6366f1';
      ctx.fillRect(0, 0, garmentWidth, garmentHeight);
    }
    
    // Fabric draping effect (gradient overlay)
    const gradient = ctx.createLinearGradient(0, 0, garmentWidth, garmentHeight);
    gradient.addColorStop(0, 'rgba(255,255,255,0.15)');
    gradient.addColorStop(0.3, 'rgba(0,0,0,0.05)');
    gradient.addColorStop(0.7, 'rgba(0,0,0,0.1)');
    gradient.addColorStop(1, 'rgba(0,0,0,0.2)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, garmentWidth, garmentHeight);
    
    ctx.restore();
  }, [product, scale, rotation, position, brightness, isFlipped, facingMode]);

  const capturePhoto = () => {
    if (!videoRef.current) return;
    
    const canvas = document.createElement('canvas');
    canvas.width = videoRef.current.videoWidth;
    canvas.height = videoRef.current.videoHeight;
    const ctx = canvas.getContext('2d');
    
    if (facingMode === "user") {
      ctx.scale(-1, 1);
      ctx.drawImage(videoRef.current, -canvas.width, 0);
    } else {
      ctx.drawImage(videoRef.current, 0, 0);
    }
    
    setUserPhoto(canvas.toDataURL('image/png'));
    stopCamera();
    setMode('upload');
    generateTryOn(canvas.toDataURL('image/png'));
  };

  const handleFileUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    
    const reader = new FileReader();
    reader.onload = (event) => {
      setUserPhoto(event.target.result);
      setMode('upload');
      generateTryOn(event.target.result);
    };
    reader.readAsDataURL(file);
  };

  const generateTryOn = async (photoData) => {
    setIsProcessing(true);
    
    try {
      // In production, this would call a real AI try-on service
      // For now, we simulate the processing and create a composite
      await new Promise(resolve => setTimeout(resolve, 1500));
      
      setTryOnResult({
        compositeUrl: photoData,
        productOverlay: product.image_url,
        fitScore: Math.floor(Math.random() * 20) + 80,
        recommendations: [
          "This style complements your body shape well",
          "Consider pairing with neutral accessories"
        ]
      });
    } catch (error) {
      console.error("Try-on generation error:", error);
    }
    
    setIsProcessing(false);
  };

  const downloadResult = () => {
    if (!overlayCanvasRef.current && !tryOnResult) return;
    
    const link = document.createElement('a');
    link.download = `tryon-${product.product_name || 'result'}.png`;
    link.href = overlayCanvasRef.current?.toDataURL() || tryOnResult?.compositeUrl;
    link.click();
  };

  const shareResult = async () => {
    if (!navigator.share) {
      alert("Sharing not supported on this device");
      return;
    }
    
    try {
      await navigator.share({
        title: `Virtual Try-On: ${product.product_name}`,
        text: "Check out how this looks on me!",
        url: window.location.href
      });
    } catch (error) {
      console.error("Share error:", error);
    }
  };

  const saveLook = async () => {
    if (onSave) {
      onSave({
        productId: product.id,
        tryOnImage: overlayCanvasRef.current?.toDataURL() || tryOnResult?.compositeUrl,
        timestamp: new Date().toISOString()
      });
    }
  };

  // AR rendering loop
  useEffect(() => {
    if (mode === 'ar' && stream) {
      const interval = setInterval(renderAROverlay, 33); // ~30fps
      return () => clearInterval(interval);
    }
  }, [mode, stream, renderAROverlay]);

  // Cleanup on unmount
  useEffect(() => {
    return () => stopCamera();
  }, [stopCamera]);

  const resetControls = () => {
    setScale([1]);
    setRotation([0]);
    setPosition({ x: 50, y: 40 });
    setBrightness([100]);
    setIsFlipped(false);
  };

  return (
    <Dialog open={isOpen} onOpenChange={() => { stopCamera(); onClose(); }}>
      <DialogContent className="max-w-4xl max-h-[90vh] overflow-y-auto">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <Scan className="w-5 h-5 text-purple-500" />
            Virtual Try-On
            {product && (
              <Badge variant="outline" className="ml-2">
                {product.product_name}
              </Badge>
            )}
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-4">
          {/* Mode Selection */}
          {!mode && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="space-y-4"
            >
              <div className="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-4 border border-purple-200">
                <div className="flex items-start gap-3">
                  <Sparkles className="w-6 h-6 text-purple-600 mt-1" />
                  <div>
                    <p className="font-semibold text-gray-900 mb-1">AI-Powered Virtual Try-On</p>
                    <p className="text-sm text-gray-600">
                      See how clothes look on you with realistic fabric draping and color accuracy
                    </p>
                  </div>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <Card 
                  className="cursor-pointer hover:shadow-lg transition-all border-2 hover:border-blue-500"
                  onClick={() => startCamera(true)}
                >
                  <CardContent className="p-6 text-center">
                    <div className="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-3">
                      <Scan className="w-8 h-8 text-blue-600" />
                    </div>
                    <h3 className="font-semibold mb-1">Live AR Try-On</h3>
                    <p className="text-xs text-gray-600">Real-time visualization</p>
                    <Badge className="mt-2 bg-blue-500">Recommended</Badge>
                  </CardContent>
                </Card>

                <Card 
                  className="cursor-pointer hover:shadow-lg transition-all border-2 hover:border-purple-500"
                  onClick={() => startCamera(false)}
                >
                  <CardContent className="p-6 text-center">
                    <div className="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mx-auto mb-3">
                      <Camera className="w-8 h-8 text-purple-600" />
                    </div>
                    <h3 className="font-semibold mb-1">Take Photo</h3>
                    <p className="text-xs text-gray-600">Capture and try on</p>
                  </CardContent>
                </Card>

                <Card 
                  className="cursor-pointer hover:shadow-lg transition-all border-2 hover:border-pink-500"
                  onClick={() => fileInputRef.current?.click()}
                >
                  <CardContent className="p-6 text-center">
                    <div className="w-16 h-16 rounded-full bg-pink-100 flex items-center justify-center mx-auto mb-3">
                      <Upload className="w-8 h-8 text-pink-600" />
                    </div>
                    <h3 className="font-semibold mb-1">Upload Photo</h3>
                    <p className="text-xs text-gray-600">Use existing photo</p>
                  </CardContent>
                </Card>
              </div>

              <input
                ref={fileInputRef}
                type="file"
                accept="image/*"
                onChange={handleFileUpload}
                className="hidden"
              />
            </motion.div>
          )}

          {/* AR Mode */}
          {mode === 'ar' && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="space-y-4"
            >
              <div className="flex items-center justify-between bg-blue-50 rounded-lg p-3">
                <div className="flex items-center gap-2">
                  <Scan className="w-5 h-5 text-blue-600 animate-pulse" />
                  <span className="text-sm font-medium text-blue-900">AR Mode Active</span>
                </div>
                <div className="flex items-center gap-2">
                  {bodyDetected && <Badge className="bg-green-500">Body Detected</Badge>}
                  <Button variant="ghost" size="sm" onClick={switchCamera}>
                    <FlipHorizontal className="w-4 h-4" />
                  </Button>
                </div>
              </div>

              <div className="relative bg-gray-900 rounded-lg overflow-hidden aspect-video">
                <video
                  ref={videoRef}
                  autoPlay
                  playsInline
                  muted
                  className="hidden"
                />
                <canvas
                  ref={overlayCanvasRef}
                  className="w-full h-full"
                />
              </div>

              {/* Transform Controls */}
              <Card>
                <CardContent className="p-4 space-y-4">
                  <div className="flex items-center justify-between">
                    <span className="text-sm font-medium">Adjust Fit</span>
                    <Button variant="ghost" size="sm" onClick={resetControls}>
                      <RotateCcw className="w-4 h-4 mr-1" />
                      Reset
                    </Button>
                  </div>

                  <div className="grid grid-cols-2 gap-4">
                    <div>
                      <label className="text-xs text-gray-500 flex items-center gap-1 mb-2">
                        <ZoomIn className="w-3 h-3" /> Size
                      </label>
                      <Slider
                        value={scale}
                        onValueChange={setScale}
                        min={0.5}
                        max={1.5}
                        step={0.05}
                      />
                    </div>
                    <div>
                      <label className="text-xs text-gray-500 flex items-center gap-1 mb-2">
                        <RotateCcw className="w-3 h-3" /> Rotation
                      </label>
                      <Slider
                        value={rotation}
                        onValueChange={setRotation}
                        min={-30}
                        max={30}
                        step={1}
                      />
                    </div>
                    <div>
                      <label className="text-xs text-gray-500 flex items-center gap-1 mb-2">
                        <SunMedium className="w-3 h-3" /> Brightness
                      </label>
                      <Slider
                        value={brightness}
                        onValueChange={setBrightness}
                        min={50}
                        max={150}
                        step={5}
                      />
                    </div>
                    <div className="flex items-end">
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => setIsFlipped(!isFlipped)}
                        className={isFlipped ? "bg-purple-100" : ""}
                      >
                        <FlipHorizontal className="w-4 h-4 mr-1" />
                        Flip
                      </Button>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <div className="flex gap-2 justify-center flex-wrap">
                <Button onClick={capturePhoto} className="bg-purple-500">
                  <Camera className="w-4 h-4 mr-2" />
                  Capture
                </Button>
                <Button variant="outline" onClick={downloadResult}>
                  <Download className="w-4 h-4 mr-2" />
                  Save
                </Button>
                <Button variant="outline" onClick={shareResult}>
                  <Share2 className="w-4 h-4 mr-2" />
                  Share
                </Button>
                <Button variant="ghost" onClick={() => { stopCamera(); setMode(null); }}>
                  <X className="w-4 h-4 mr-2" />
                  Exit
                </Button>
              </div>
            </motion.div>
          )}

          {/* Camera Mode (Non-AR) */}
          {mode === 'camera' && !userPhoto && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="space-y-4"
            >
              <div className="relative bg-gray-900 rounded-lg overflow-hidden aspect-video">
                <video
                  ref={videoRef}
                  autoPlay
                  playsInline
                  muted
                  className="w-full h-full object-cover"
                  style={{ transform: facingMode === "user" ? "scaleX(-1)" : "none" }}
                />
              </div>

              <div className="flex gap-2 justify-center">
                <Button onClick={capturePhoto} className="bg-purple-500">
                  <Camera className="w-4 h-4 mr-2" />
                  Capture Photo
                </Button>
                <Button variant="outline" onClick={switchCamera}>
                  <RefreshCw className="w-4 h-4 mr-2" />
                  Switch Camera
                </Button>
                <Button variant="ghost" onClick={() => { stopCamera(); setMode(null); }}>
                  Cancel
                </Button>
              </div>
            </motion.div>
          )}

          {/* Upload/Result Mode */}
          {mode === 'upload' && userPhoto && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="space-y-4"
            >
              {isProcessing ? (
                <div className="text-center py-12">
                  <Loader2 className="w-12 h-12 animate-spin mx-auto text-purple-500 mb-4" />
                  <p className="font-medium">Processing your try-on...</p>
                  <p className="text-sm text-gray-500">Analyzing body shape and applying garment</p>
                </div>
              ) : (
                <>
                  <div className="relative bg-gray-100 rounded-lg overflow-hidden">
                    <img
                      src={userPhoto}
                      alt="Try-on preview"
                      className="w-full max-h-96 object-contain"
                    />
                    
                    {/* Product Overlay */}
                    {product?.image_url && (
                      <motion.div
                        initial={{ opacity: 0, scale: 0.8 }}
                        animate={{ opacity: 0.9, scale: scale[0] }}
                        className="absolute"
                        style={{
                          left: `${position.x}%`,
                          top: `${position.y}%`,
                          transform: `translate(-50%, -50%) rotate(${rotation[0]}deg) ${isFlipped ? 'scaleX(-1)' : ''}`,
                          filter: `brightness(${brightness[0]}%)`
                        }}
                        drag
                        onDrag={(e, info) => {
                          const rect = e.target.parentElement.getBoundingClientRect();
                          setPosition({
                            x: ((info.point.x - rect.left) / rect.width) * 100,
                            y: ((info.point.y - rect.top) / rect.height) * 100
                          });
                        }}
                      >
                        <img
                          src={product.image_url}
                          alt={product.product_name}
                          className="w-40 h-52 object-contain cursor-move"
                          draggable={false}
                        />
                      </motion.div>
                    )}
                  </div>

                  {/* Fit Score */}
                  {tryOnResult?.fitScore && (
                    <Card className="bg-gradient-to-r from-green-50 to-emerald-50 border-green-200">
                      <CardContent className="p-4">
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="text-sm text-gray-600">Fit Score</p>
                            <p className="text-2xl font-bold text-green-600">{tryOnResult.fitScore}%</p>
                          </div>
                          <Check className="w-8 h-8 text-green-500" />
                        </div>
                        {tryOnResult.recommendations?.map((rec, i) => (
                          <p key={i} className="text-xs text-gray-600 mt-1">• {rec}</p>
                        ))}
                      </CardContent>
                    </Card>
                  )}

                  {/* Controls */}
                  <Card>
                    <CardContent className="p-4 space-y-3">
                      <div className="grid grid-cols-2 gap-4">
                        <div>
                          <label className="text-xs text-gray-500 mb-1 block">Size</label>
                          <Slider value={scale} onValueChange={setScale} min={0.5} max={1.5} step={0.05} />
                        </div>
                        <div>
                          <label className="text-xs text-gray-500 mb-1 block">Rotation</label>
                          <Slider value={rotation} onValueChange={setRotation} min={-30} max={30} step={1} />
                        </div>
                      </div>
                    </CardContent>
                  </Card>

                  <div className="flex gap-2 justify-center flex-wrap">
                    <Button onClick={saveLook} className="bg-gradient-to-r from-purple-500 to-pink-500">
                      <Check className="w-4 h-4 mr-2" />
                      Save Look
                    </Button>
                    <Button variant="outline" onClick={downloadResult}>
                      <Download className="w-4 h-4 mr-2" />
                      Download
                    </Button>
                    <Button variant="outline" onClick={shareResult}>
                      <Share2 className="w-4 h-4 mr-2" />
                      Share
                    </Button>
                    <Button
                      variant="ghost"
                      onClick={() => {
                        setUserPhoto(null);
                        setTryOnResult(null);
                        setMode(null);
                        resetControls();
                      }}
                    >
                      Try Again
                    </Button>
                  </div>
                </>
              )}
            </motion.div>
          )}
        </div>
      </DialogContent>
    </Dialog>
  );
}
