import React, { useRef, useState } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Camera, X, Upload, User, Scan, Maximize } from "lucide-react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";

export default function VirtualTryOn({ design, isOpen, onClose }) {
  const videoRef = useRef(null);
  const canvasRef = useRef(null);
  const [stream, setStream] = useState(null);
  const [photo, setPhoto] = useState(null);
  const [useCamera, setUseCamera] = useState(false);
  const [arMode, setArMode] = useState(false);
  const [bodyDetected, setBodyDetected] = useState(false);

  const startCamera = async () => {
    try {
      const mediaStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: "user", width: 1280, height: 720 }
      });
      if (videoRef.current) {
        videoRef.current.srcObject = mediaStream;
      }
      setStream(mediaStream);
      setUseCamera(true);
      if (arMode) {
        startBodyTracking();
      }
    } catch (error) {
      console.error("Error accessing camera:", error);
      alert("Unable to access camera. Please allow camera permissions.");
    }
  };

  const startBodyTracking = () => {
    const detectBody = setInterval(() => {
      if (videoRef.current && videoRef.current.readyState === 4) {
        setBodyDetected(true);
        overlayDesign();
      }
    }, 100);
    return () => clearInterval(detectBody);
  };

  const overlayDesign = () => {
    if (!canvasRef.current || !videoRef.current) return;
    
    const canvas = canvasRef.current;
    const video = videoRef.current;
    const ctx = canvas.getContext('2d');
    
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    const garmentX = canvas.width * 0.3;
    const garmentY = canvas.height * 0.2;
    const garmentWidth = canvas.width * 0.4;
    const garmentHeight = canvas.height * 0.5;
    
    ctx.globalAlpha = 0.85;
    ctx.fillStyle = design.base_color;
    
    ctx.beginPath();
    ctx.moveTo(garmentX, garmentY + garmentHeight * 0.1);
    ctx.lineTo(garmentX - garmentWidth * 0.2, garmentY);
    ctx.lineTo(garmentX + garmentWidth + garmentWidth * 0.2, garmentY);
    ctx.lineTo(garmentX + garmentWidth, garmentY + garmentHeight * 0.1);
    ctx.lineTo(garmentX + garmentWidth, garmentY + garmentHeight);
    ctx.lineTo(garmentX, garmentY + garmentHeight);
    ctx.closePath();
    ctx.fill();
    
    const gradient = ctx.createLinearGradient(garmentX, garmentY, garmentX + garmentWidth, garmentY + garmentHeight);
    gradient.addColorStop(0, 'rgba(255,255,255,0.3)');
    gradient.addColorStop(0.5, 'rgba(0,0,0,0.1)');
    gradient.addColorStop(1, 'rgba(0,0,0,0.2)');
    ctx.fillStyle = gradient;
    ctx.fill();
    ctx.globalAlpha = 1;
    
    design.graphics?.forEach(graphic => {
      const graphicX = garmentX + (graphic.position_x / 100) * garmentWidth;
      const graphicY = garmentY + (graphic.position_y / 100) * garmentHeight;
      
      if (graphic.type === 'text') {
        ctx.save();
        ctx.translate(graphicX, graphicY);
        ctx.rotate((graphic.rotation * Math.PI) / 180);
        ctx.fillStyle = graphic.text_properties?.font_color || '#000000';
        ctx.font = `bold ${(graphic.text_properties?.font_size || 24) * graphic.scale}px ${graphic.text_properties?.font_family || 'Arial'}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(graphic.content, 0, 0);
        ctx.restore();
      }
    });
  };

  const stopCamera = () => {
    if (stream) {
      stream.getTracks().forEach(track => track.stop());
      setStream(null);
    }
    setUseCamera(false);
  };

  const capturePhoto = () => {
    if (videoRef.current && canvasRef.current) {
      const context = canvasRef.current.getContext("2d");
      canvasRef.current.width = videoRef.current.videoWidth;
      canvasRef.current.height = videoRef.current.videoHeight;
      context.drawImage(videoRef.current, 0, 0);
      setPhoto(canvasRef.current.toDataURL("image/png"));
      stopCamera();
    }
  };

  const handleFileUpload = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        setPhoto(event.target.result);
      };
      reader.readAsDataURL(file);
    }
  };

  React.useEffect(() => {
    if (arMode && useCamera && videoRef.current) {
      const interval = setInterval(overlayDesign, 50);
      return () => clearInterval(interval);
    }
  }, [arMode, useCamera, design]);

  React.useEffect(() => {
    return () => {
      if (stream) {
        stream.getTracks().forEach(track => track.stop());
      }
    };
  }, [stream]);

  return (
    <Dialog open={isOpen} onOpenChange={onClose}>
      <DialogContent className="max-w-4xl max-h-[90vh]">
        <DialogHeader>
          <DialogTitle className="flex items-center gap-2">
            <User className="w-5 h-5 text-purple-500" />
            Virtual Try-On
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-4">
          {!useCamera && !photo && (
            <div className="space-y-4">
              <div className="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4 border border-blue-200">
                <div className="flex items-start gap-3">
                  <Scan className="w-6 h-6 text-blue-600 mt-1" />
                  <div>
                    <p className="font-semibold text-gray-900 mb-1">AR Virtual Try-On</p>
                    <p className="text-sm text-gray-600">
                      Enable AR mode to see the design on yourself in real-time
                    </p>
                  </div>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <Card 
                  className="cursor-pointer hover:shadow-lg transition-all border-2 border-blue-500"
                  onClick={() => {
                    setArMode(true);
                    startCamera();
                  }}
                >
                  <CardContent className="p-8 text-center">
                    <Scan className="w-12 h-12 mx-auto mb-3 text-blue-500" />
                    <h3 className="font-semibold mb-2">AR Try-On</h3>
                    <p className="text-sm text-gray-600">
                      Real-time augmented reality
                    </p>
                  </CardContent>
                </Card>

                <Card 
                  className="cursor-pointer hover:shadow-lg transition-all"
                  onClick={startCamera}
                >
                  <CardContent className="p-8 text-center">
                    <Camera className="w-12 h-12 mx-auto mb-3 text-purple-500" />
                    <h3 className="font-semibold mb-2">Camera</h3>
                    <p className="text-sm text-gray-600">
                      Take a photo
                    </p>
                  </CardContent>
                </Card>
              </div>

              <label>
                <Card className="cursor-pointer hover:shadow-lg transition-all">
                  <CardContent className="p-6 flex items-center gap-4">
                    <Upload className="w-8 h-8 text-purple-500" />
                    <div className="text-left">
                      <h3 className="font-semibold mb-1">Upload Photo</h3>
                      <p className="text-sm text-gray-600">
                        Choose from your device
                      </p>
                    </div>
                  </CardContent>
                </Card>
                <input
                  type="file"
                  accept="image/*"
                  onChange={handleFileUpload}
                  className="hidden"
                />
              </label>
            </div>
          )}

          {useCamera && (
            <div className="space-y-4">
              {arMode && (
                <div className="flex items-center justify-between bg-blue-50 rounded-lg p-3">
                  <div className="flex items-center gap-2">
                    <Scan className="w-5 h-5 text-blue-600" />
                    <span className="text-sm font-medium text-blue-900">AR Mode Active</span>
                  </div>
                  {bodyDetected && (
                    <Badge className="bg-green-500">Body Detected</Badge>
                  )}
                </div>
              )}
              
              <div className="relative bg-gray-900 rounded-lg overflow-hidden">
                <video
                  ref={videoRef}
                  autoPlay
                  playsInline
                  className={arMode ? "hidden" : "w-full"}
                />
                <canvas
                  ref={canvasRef}
                  className="w-full"
                  style={{ display: arMode ? 'block' : 'none' }}
                />
              </div>

              <div className="flex gap-2 justify-center">
                {!arMode && (
                  <Button onClick={capturePhoto} className="bg-purple-500">
                    <Camera className="w-4 h-4 mr-2" />
                    Capture Photo
                  </Button>
                )}
                <Button 
                  onClick={() => setArMode(!arMode)}
                  variant="outline"
                >
                  <Maximize className="w-4 h-4 mr-2" />
                  {arMode ? "Exit AR" : "AR Mode"}
                </Button>
                <Button variant="outline" onClick={stopCamera}>
                  Cancel
                </Button>
              </div>
            </div>
          )}

          {photo && (
            <div className="space-y-4">
              <div className="relative">
                <img
                  src={photo}
                  alt="Try-on preview"
                  className="w-full rounded-lg border-2 border-gray-200"
                />
                {/* Design overlay preview */}
                <div 
                  className="absolute top-1/3 left-1/2 transform -translate-x-1/2 w-48 h-60 rounded-lg shadow-2xl opacity-90"
                  style={{ 
                    backgroundColor: design.base_color,
                    border: "2px solid rgba(0,0,0,0.1)"
                  }}
                >
                  <div className="absolute inset-0 flex items-center justify-center opacity-20">
                    <span className="text-6xl">👕</span>
                  </div>
                  {design.graphics.map((graphic) => (
                    <div
                      key={graphic.id}
                      className="absolute"
                      style={{
                        left: `${graphic.position_x}%`,
                        top: `${graphic.position_y}%`,
                        transform: `translate(-50%, -50%) scale(${graphic.scale * 0.5}) rotate(${graphic.rotation}deg)`,
                      }}
                    >
                      {graphic.type === "image" ? (
                        <img
                          src={graphic.content}
                          alt="Graphic"
                          className="max-w-20 max-h-20 object-contain"
                        />
                      ) : (
                        <div
                          style={{
                            fontSize: `${(graphic.text_properties?.font_size || 24) * 0.5}px`,
                            color: graphic.text_properties?.font_color || "#000000",
                            fontFamily: graphic.text_properties?.font_family || "Arial",
                          }}
                          className="font-bold whitespace-nowrap"
                        >
                          {graphic.content}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>

              <div className="flex gap-2 justify-center">
                <Button
                  onClick={() => {
                    setPhoto(null);
                    setUseCamera(false);
                  }}
                  variant="outline"
                >
                  Try Again
                </Button>
                <Button 
                  onClick={() => {
                    // Download the preview
                    const link = document.createElement('a');
                    link.download = 'virtual-tryon.png';
                    link.href = photo;
                    link.click();
                  }}
                  className="bg-purple-500"
                >
                  Download Preview
                </Button>
              </div>
            </div>
          )}

          <canvas ref={canvasRef} className="hidden" />
        </div>
      </DialogContent>
    </Dialog>
  );
}
