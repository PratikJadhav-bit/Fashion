import React from "react";
import { base44 } from "@/api/base44Client";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Textarea } from "@/components/ui/textarea";
import { Badge } from "@/components/ui/badge";
import {
  Sparkles,
  Loader2,
  Palette,
  Lightbulb,
  Wand2
} from "lucide-react";

export default function AIDesignAssistant({ design, onApplySuggestion }) {
  const [prompt, setPrompt] = React.useState("");
  const [suggestions, setSuggestions] = React.useState(null);
  const [isGenerating, setIsGenerating] = React.useState(false);

  const generateSuggestions = async () => {
    if (!prompt.trim() && !design) return;

    setIsGenerating(true);
    try {
      const contextPrompt = `Analyze this current design:
- Garment: ${design.garment_type}
- Material: ${design.material}
- Base Color: ${design.base_color}
- Current Graphics: ${design.graphics?.length || 0}

User request: ${prompt || "Suggest improvements"}

Provide specific design suggestions:
1. Complementary colors (3-4 hex codes)
2. Design elements to add (text, graphics, patterns)
3. Material recommendations for this style
4. Alternative garment types that would work well
5. Layout/composition tips

Format as JSON.`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt: contextPrompt,
        add_context_from_internet: true,
        response_json_schema: {
          type: "object",
          properties: {
            colors: { type: "array", items: { type: "string" } },
            elements: { type: "array", items: { type: "string" } },
            materials: { type: "array", items: { type: "string" } },
            garments: { type: "array", items: { type: "string" } },
            layout_tips: { type: "string" }
          }
        }
      });

      setSuggestions(result);
    } catch (error) {
      console.error("Error generating suggestions:", error);
    }
    setIsGenerating(false);
  };

  const applyColor = (color) => {
    onApplySuggestion({ type: 'color', value: color });
  };

  const applyMaterial = (material) => {
    onApplySuggestion({ type: 'material', value: material });
  };

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <Wand2 className="w-5 h-5 text-purple-500" />
          AI Design Assistant
        </CardTitle>
      </CardHeader>
      <CardContent className="space-y-4">
        <div>
          <Textarea
            placeholder="Ask AI for suggestions (e.g., 'Make it more vibrant', 'Add vintage elements')..."
            value={prompt}
            onChange={(e) => setPrompt(e.target.value)}
            rows={3}
          />
        </div>

        <Button
          onClick={generateSuggestions}
          disabled={isGenerating}
          className="w-full bg-gradient-to-r from-purple-500 to-pink-500"
        >
          {isGenerating ? (
            <>
              <Loader2 className="w-4 h-4 mr-2 animate-spin" />
              Analyzing...
            </>
          ) : (
            <>
              <Sparkles className="w-4 h-4 mr-2" />
              Get AI Suggestions
            </>
          )}
        </Button>

        {suggestions && (
          <div className="space-y-4 pt-4 border-t">
            {/* Color Suggestions */}
            {suggestions.colors?.length > 0 && (
              <div>
                <p className="text-sm font-semibold mb-2 flex items-center gap-2">
                  <Palette className="w-4 h-4" />
                  Suggested Colors
                </p>
                <div className="flex gap-2 flex-wrap">
                  {suggestions.colors.map((color, i) => (
                    <button
                      key={i}
                      onClick={() => applyColor(color)}
                      className="w-12 h-12 rounded-lg border-2 border-gray-300 hover:border-purple-500 transition-all hover:scale-110"
                      style={{ backgroundColor: color }}
                      title={`Apply ${color}`}
                    />
                  ))}
                </div>
              </div>
            )}

            {/* Element Suggestions */}
            {suggestions.elements?.length > 0 && (
              <div>
                <p className="text-sm font-semibold mb-2 flex items-center gap-2">
                  <Lightbulb className="w-4 h-4" />
                  Design Elements
                </p>
                <div className="flex gap-2 flex-wrap">
                  {suggestions.elements.map((element, i) => (
                    <Badge key={i} variant="outline" className="cursor-default">
                      {element}
                    </Badge>
                  ))}
                </div>
              </div>
            )}

            {/* Material Suggestions */}
            {suggestions.materials?.length > 0 && (
              <div>
                <p className="text-sm font-semibold mb-2">Recommended Materials</p>
                <div className="flex gap-2 flex-wrap">
                  {suggestions.materials.map((material, i) => (
                    <Button
                      key={i}
                      variant="outline"
                      size="sm"
                      onClick={() => applyMaterial(material)}
                    >
                      {material.replace(/_/g, ' ')}
                    </Button>
                  ))}
                </div>
              </div>
            )}

            {/* Layout Tips */}
            {suggestions.layout_tips && (
              <div className="bg-blue-50 rounded-lg p-3">
                <p className="text-sm text-gray-700">
                  <strong>Layout Tip:</strong> {suggestions.layout_tips}
                </p>
              </div>
            )}
          </div>
        )}
      </CardContent>
    </Card>
  );
}