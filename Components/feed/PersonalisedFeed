import React from "react";
import { useQuery } from "@tanstack/react-query";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { motion, AnimatePresence } from "framer-motion";
import {
  Heart,
  MessageCircle,
  UserPlus,
  Star,
  Sparkles,
  Users,
  TrendingUp
} from "lucide-react";

export default function PersonalizedFeed({ user, userProfile, userFollows = [], onRequireAuth }) {
  const navigate = useNavigate();

  // Fetch outfits from followed users
  const { data: followedOutfits = [] } = useQuery({
    queryKey: ['followedOutfits', userFollows],
    queryFn: async () => {
      if (userFollows.length === 0) return [];
      const followedEmails = userFollows.map(f => f.following_email);
      const allOutfits = await base44.entities.OutfitHistory.filter({ is_favorite: true }, '-created_date', 50);
      return allOutfits.filter(o => followedEmails.includes(o.user_email) && o.outfit_photo_url);
    },
    enabled: userFollows.length > 0,
    initialData: [],
  });

  // Fetch trending outfits matching user's style DNA
  const { data: styleTrendingOutfits = [] } = useQuery({
    queryKey: ['styleTrendingOutfits', userProfile?.style_dna],
    queryFn: async () => {
      const allOutfits = await base44.entities.OutfitHistory.filter({ is_favorite: true }, '-created_date', 50);
      
      if (!userProfile?.style_dna?.topStyles) {
        return allOutfits.filter(o => o.outfit_photo_url).slice(0, 10);
      }

      const userStyles = userProfile.style_dna.topStyles.map(([style]) => style.toLowerCase());
      
      // Score outfits by style match
      const scoredOutfits = allOutfits
        .filter(o => o.outfit_photo_url)
        .map(outfit => {
          let score = 0;
          const outfitText = `${outfit.outfit_description || ''} ${outfit.occasion_type || ''}`.toLowerCase();
          
          userStyles.forEach((style, i) => {
            if (outfitText.includes(style)) {
              score += (4 - i) * 10; // Weight by position in DNA
            }
          });
          
          // Boost by rating
          if (outfit.rating) score += outfit.rating * 5;
          
          return { ...outfit, styleScore: score };
        })
        .sort((a, b) => b.styleScore - a.styleScore);

      return scoredOutfits.slice(0, 15);
    },
    enabled: !!userProfile,
    initialData: [],
  });

  // Combine and deduplicate feeds
  const combinedFeed = React.useMemo(() => {
    const seen = new Set();
    const combined = [];

    // Prioritize followed users' content
    followedOutfits.forEach(outfit => {
      if (!seen.has(outfit.id)) {
        seen.add(outfit.id);
        combined.push({ ...outfit, feedSource: 'following' });
      }
    });

    // Add style-matching trending
    styleTrendingOutfits.forEach(outfit => {
      if (!seen.has(outfit.id)) {
        seen.add(outfit.id);
        combined.push({ ...outfit, feedSource: 'trending' });
      }
    });

    return combined.slice(0, 20);
  }, [followedOutfits, styleTrendingOutfits]);

  const isFollowing = (email) => userFollows.some(f => f.following_email === email);

  if (combinedFeed.length === 0) {
    return (
      <div className="text-center py-12">
        <Users className="w-16 h-16 mx-auto mb-4 text-gray-300" />
        <h3 className="text-lg font-semibold text-gray-900 mb-2">Your Feed is Empty</h3>
        <p className="text-gray-600 mb-4">
          Follow creators and complete your Style DNA quiz to see personalized content!
        </p>
        <div className="flex gap-3 justify-center">
          <Button
            onClick={() => navigate(createPageUrl("StyleDNAQuiz"))}
            className="bg-gradient-to-r from-purple-500 to-pink-500"
          >
            <Sparkles className="w-4 h-4 mr-2" />
            Take Style Quiz
          </Button>
          <Button
            variant="outline"
            onClick={() => navigate(createPageUrl("CommunityStyle"))}
          >
            Browse Community
          </Button>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-4">
      <div className="flex items-center gap-2 mb-4">
        <Sparkles className="w-5 h-5 text-purple-500" />
        <h2 className="text-lg font-semibold">Your Personalized Feed</h2>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <AnimatePresence>
          {combinedFeed.map((outfit, index) => (
            <motion.div
              key={outfit.id}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: index * 0.05 }}
            >
              <Card className="group overflow-hidden hover:shadow-lg transition-shadow">
                <CardHeader className="p-3">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <div className="w-8 h-8 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center text-white text-sm font-semibold">
                        {(outfit.user_email || '?')[0].toUpperCase()}
                      </div>
                      <div>
                        <p className="text-sm font-medium">{outfit.user_email?.split('@')[0]}</p>
                        <p className="text-xs text-gray-500">
                          {new Date(outfit.created_date).toLocaleDateString()}
                        </p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      {outfit.feedSource === 'following' && (
                        <Badge className="bg-blue-100 text-blue-700 text-xs">Following</Badge>
                      )}
                      {outfit.feedSource === 'trending' && outfit.styleScore > 20 && (
                        <Badge className="bg-purple-100 text-purple-700 text-xs">
                          <TrendingUp className="w-3 h-3 mr-1" />
                          Your Style
                        </Badge>
                      )}
                    </div>
                  </div>
                </CardHeader>

                <div className="relative h-48 bg-gray-100 overflow-hidden">
                  {outfit.outfit_photo_url ? (
                    <img
                      src={outfit.outfit_photo_url}
                      alt={outfit.occasion_name || "Outfit"}
                      className="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    />
                  ) : (
                    <div className="flex items-center justify-center h-full text-6xl opacity-30">
                      👗
                    </div>
                  )}
                  {outfit.rating && (
                    <div className="absolute top-2 right-2">
                      <Badge className="bg-yellow-100 text-yellow-800">
                        <Star className="w-3 h-3 mr-1 fill-current" />
                        {outfit.rating}
                      </Badge>
                    </div>
                  )}
                </div>

                <CardContent className="p-3">
                  <h3 className="font-medium text-gray-900 mb-1">
                    {outfit.occasion_name || outfit.occasion_type}
                  </h3>
                  {outfit.outfit_description && (
                    <p className="text-sm text-gray-600 line-clamp-2 mb-2">
                      {outfit.outfit_description}
                    </p>
                  )}
                  <div className="flex items-center gap-3 text-gray-500 text-sm">
                    <button className="flex items-center gap-1 hover:text-pink-600">
                      <Heart className="w-4 h-4" />
                      Like
                    </button>
                    <button className="flex items-center gap-1 hover:text-blue-600">
                      <MessageCircle className="w-4 h-4" />
                      Comment
                    </button>
                  </div>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </AnimatePresence>
      </div>
    </div>
  );
}
