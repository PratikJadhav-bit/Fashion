import React from "react";
import { useQuery } from "@tanstack/react-query";
import { base44 } from "@/api/base44Client";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { motion } from "framer-motion";
import {
  Sparkles,
  ShoppingBag,
  Loader2,
  Lightbulb,
  Palette,
  TrendingUp,
  ExternalLink
} from "lucide-react";

// Style archetype definitions for users with few items
const styleArchetypes = {
  minimalist: {
    name: "Minimalist Essentials",
    essentials: ["white t-shirt", "black pants", "neutral blazer", "white sneakers", "classic jeans"],
    colors: ["white", "black", "gray", "beige", "navy"]
  },
  boho: {
    name: "Bohemian Basics",
    essentials: ["flowy maxi dress", "denim jacket", "ankle boots", "layered necklaces", "wide-leg pants"],
    colors: ["brown", "rust", "olive", "cream", "terracotta"]
  },
  classic: {
    name: "Classic Staples",
    essentials: ["button-down shirt", "tailored trousers", "loafers", "blazer", "knee-length skirt"],
    colors: ["navy", "white", "camel", "burgundy", "forest green"]
  },
  glam: {
    name: "Glamorous Must-Haves",
    essentials: ["statement dress", "heels", "clutch bag", "sparkly top", "fitted blazer"],
    colors: ["black", "gold", "red", "silver", "emerald"]
  },
  casual: {
    name: "Casual Comfort",
    essentials: ["comfortable jeans", "hoodie", "sneakers", "basic tees", "joggers"],
    colors: ["gray", "blue", "black", "white", "green"]
  },
  edgy: {
    name: "Edgy Essentials",
    essentials: ["leather jacket", "black boots", "band tee", "skinny jeans", "choker"],
    colors: ["black", "gray", "burgundy", "silver", "dark green"]
  }
};

export default function SmartWardrobeAnalyzer({ userEmail, userProfile }) {
  const [analysis, setAnalysis] = React.useState(null);
  const [isAnalyzing, setIsAnalyzing] = React.useState(false);

  const { data: wardrobeItems = [] } = useQuery({
    queryKey: ['wardrobe', userEmail],
    queryFn: () => base44.entities.WardrobeItem.filter({ user_email: userEmail }),
    enabled: !!userEmail,
    initialData: [],
  });

  const { data: affiliateProducts = [] } = useQuery({
    queryKey: ['affiliateProducts'],
    queryFn: () => base44.entities.AffiliateProduct.filter({ is_active: true }),
    initialData: [],
  });

  const analyzeWardrobe = async () => {
    setIsAnalyzing(true);

    try {
      let styleBasis = userProfile?.style_dna?.primaryStyle || 'casual';
      let userStyles = userProfile?.style_dna?.topStyles?.map(([s]) => s) || ['casual'];
      
      // Build wardrobe context
      const wardrobeContext = wardrobeItems.length > 0
        ? wardrobeItems.map(item => ({
            name: item.item_name,
            category: item.category,
            colors: item.colors || [],
            style_tags: item.style_tags || []
          }))
        : [];

      // Get archetype essentials based on user's style
      const archetype = styleArchetypes[styleBasis] || styleArchetypes.casual;

      const prompt = `You are a fashion stylist AI. Analyze this wardrobe and provide smart suggestions.

${wardrobeItems.length > 0 ? `
USER'S CURRENT WARDROBE (${wardrobeItems.length} items):
${JSON.stringify(wardrobeContext, null, 2)}
` : `
USER HAS NO WARDROBE ITEMS YET.
Their Style DNA indicates they prefer: ${userStyles.join(', ')}
Using ${archetype.name} archetype as basis.
Essential items for this style: ${archetype.essentials.join(', ')}
`}

USER STYLE PREFERENCES: ${userStyles.join(', ')}
FAVORITE COLORS: ${userProfile?.favorite_colors?.join(', ') || 'Not specified'}

Provide:
1. **outfit_combinations**: 3-4 outfit ideas using existing items OR archetype essentials if no items
2. **missing_essentials**: 5 key items they should add (specific and actionable)
3. **color_gaps**: Colors they should add based on their palette
4. **style_tips**: 2-3 personalized styling tips
5. **capsule_suggestions**: How to build a cohesive capsule wardrobe

Return as JSON.`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt,
        response_json_schema: {
          type: "object",
          properties: {
            outfit_combinations: { type: "array", items: { type: "string" } },
            missing_essentials: { type: "array", items: { type: "string" } },
            color_gaps: { type: "array", items: { type: "string" } },
            style_tips: { type: "array", items: { type: "string" } },
            capsule_suggestions: { type: "string" }
          }
        }
      });

      // Find matching products for gaps
      const recommendedProducts = affiliateProducts.filter(product => {
        const productText = `${product.product_name} ${product.category} ${(product.style_tags || []).join(' ')}`.toLowerCase();
        return result.missing_essentials?.some(essential =>
          essential.toLowerCase().split(' ').some(word => 
            productText.includes(word) && word.length > 3
          )
        );
      }).slice(0, 6);

      setAnalysis({
        ...result,
        recommendedProducts,
        archetype: wardrobeItems.length < 5 ? archetype : null,
        totalItems: wardrobeItems.length
      });
    } catch (error) {
      console.error("Error analyzing wardrobe:", error);
    }

    setIsAnalyzing(false);
  };

  if (isAnalyzing) {
    return (
      <div className="flex flex-col items-center justify-center py-16">
        <Loader2 className="w-12 h-12 animate-spin text-purple-500 mb-4" />
        <p className="text-gray-600">Analyzing your style and generating suggestions...</p>
      </div>
    );
  }

  if (!analysis) {
    return (
      <div className="text-center py-12">
        <Sparkles className="w-16 h-16 mx-auto mb-4 text-purple-300" />
        <h3 className="text-xl font-semibold text-gray-900 mb-2">Smart Wardrobe Analyzer</h3>
        <p className="text-gray-600 mb-6 max-w-md mx-auto">
          {wardrobeItems.length > 0
            ? `Analyze your ${wardrobeItems.length} items to get AI-powered outfit ideas and identify wardrobe gaps.`
            : "Even without wardrobe items, we can suggest essentials based on your Style DNA!"}
        </p>
        <Button onClick={analyzeWardrobe} className="bg-gradient-to-r from-purple-500 to-pink-500">
          <Sparkles className="w-4 h-4 mr-2" />
          {wardrobeItems.length > 0 ? "Analyze My Wardrobe" : "Get Style Essentials"}
        </Button>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Archetype Banner (for users with few items) */}
      {analysis.archetype && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}>
          <Card className="bg-gradient-to-r from-purple-100 to-pink-100 border-purple-200">
            <CardContent className="p-6">
              <div className="flex items-start gap-4">
                <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center">
                  <Lightbulb className="w-6 h-6 text-white" />
                </div>
                <div>
                  <h3 className="font-semibold text-lg text-gray-900 mb-1">
                    Building Your {analysis.archetype.name}
                  </h3>
                  <p className="text-sm text-gray-700 mb-3">
                    Based on your Style DNA, here are the essential pieces you need to build a cohesive wardrobe.
                  </p>
                  <div className="flex flex-wrap gap-2">
                    {analysis.archetype.essentials.slice(0, 5).map((item, i) => (
                      <Badge key={i} variant="secondary" className="bg-white/80">
                        {item}
                      </Badge>
                    ))}
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Outfit Combinations */}
      {analysis.outfit_combinations?.length > 0 && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}>
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <TrendingUp className="w-5 h-5 text-green-500" />
                Outfit Ideas
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="space-y-3">
                {analysis.outfit_combinations.map((combo, i) => (
                  <div key={i} className="bg-green-50 rounded-lg p-4">
                    <span className="font-medium text-green-700">Look {i + 1}:</span>
                    <p className="text-gray-700 mt-1">{combo}</p>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Missing Essentials */}
      {analysis.missing_essentials?.length > 0 && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}>
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ShoppingBag className="w-5 h-5 text-orange-500" />
                Items to Add
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-2 mb-6">
                {analysis.missing_essentials.map((item, i) => (
                  <div key={i} className="flex items-center gap-2 bg-orange-50 rounded-lg p-3">
                    <div className="w-2 h-2 rounded-full bg-orange-500" />
                    <span className="text-sm text-gray-700">{item}</span>
                  </div>
                ))}
              </div>

              {/* Recommended Products */}
              {analysis.recommendedProducts?.length > 0 && (
                <div>
                  <h4 className="font-medium text-sm text-gray-700 mb-3">Shop These Items</h4>
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {analysis.recommendedProducts.map((product) => (
                      <a
                        key={product.id}
                        href={product.product_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="block group"
                      >
                        <Card className="hover:shadow-lg transition-shadow overflow-hidden">
                          {product.image_url && (
                            <div className="aspect-square bg-gray-100 overflow-hidden">
                              <img
                                src={product.image_url}
                                alt={product.product_name}
                                className="w-full h-full object-cover group-hover:scale-110 transition-transform"
                              />
                            </div>
                          )}
                          <CardContent className="p-3">
                            <p className="text-xs font-medium text-gray-900 line-clamp-2 mb-1">
                              {product.product_name}
                            </p>
                            <div className="flex items-center justify-between">
                              <Badge className="bg-green-500 text-xs">₹{product.price}</Badge>
                              <ExternalLink className="w-3 h-3 text-gray-400" />
                            </div>
                          </CardContent>
                        </Card>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Color Gaps */}
      {analysis.color_gaps?.length > 0 && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}>
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Palette className="w-5 h-5 text-blue-500" />
                Color Suggestions
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div className="flex flex-wrap gap-2">
                {analysis.color_gaps.map((color, i) => (
                  <Badge key={i} variant="outline" className="px-3 py-1">
                    {color}
                  </Badge>
                ))}
              </div>
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Style Tips */}
      {analysis.style_tips?.length > 0 && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}>
          <Card className="bg-gradient-to-r from-blue-50 to-purple-50 border-blue-200">
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <Lightbulb className="w-5 h-5 text-yellow-500" />
                Pro Style Tips
              </CardTitle>
            </CardHeader>
            <CardContent>
              <ul className="space-y-2">
                {analysis.style_tips.map((tip, i) => (
                  <li key={i} className="flex items-start gap-2">
                    <span className="text-yellow-500 mt-1">✨</span>
                    <span className="text-gray-700">{tip}</span>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </motion.div>
      )}

      {/* Capsule Wardrobe */}
      {analysis.capsule_suggestions && (
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.5 }}>
          <Card>
            <CardHeader>
              <CardTitle>Capsule Wardrobe Guide</CardTitle>
            </CardHeader>
            <CardContent>
              <p className="text-gray-700">{analysis.capsule_suggestions}</p>
            </CardContent>
          </Card>
        </motion.div>
      )}

      <div className="text-center pt-4">
        <Button onClick={analyzeWardrobe} variant="outline">
          <Sparkles className="w-4 h-4 mr-2" />
          Refresh Analysis
        </Button>
      </div>
    </div>
  );
}
