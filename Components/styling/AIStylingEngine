import React from "react";
import { base44 } from "@/api/base44Client";
import { createPageUrl } from "@/utils";
import { useNavigate } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { motion, AnimatePresence } from "framer-motion";
import {
  Sparkles,
  Loader2,
  Shirt,
  Calendar,
  TrendingUp,
  Sun,
  Cloud,
  Palette,
  ShoppingBag,
  ExternalLink,
  RefreshCw,
  Heart,
  Briefcase,
  PartyPopper,
  Coffee
} from "lucide-react";

const occasionIcons = {
  casual: Coffee,
  work: Briefcase,
  party: PartyPopper,
  date: Heart,
  formal: Sparkles,
  seasonal: Sun
};

export default function AIStyleEngine({ user, userProfile, wardrobeItems = [], affiliateProducts = [] }) {
  const navigate = useNavigate();
  const [recommendations, setRecommendations] = React.useState(null);
  const [isLoading, setIsLoading] = React.useState(false);
  const [selectedOccasion, setSelectedOccasion] = React.useState('casual');

  const occasions = [
    { id: 'casual', label: 'Casual', icon: Coffee, description: 'Everyday comfort' },
    { id: 'work', label: 'Work', icon: Briefcase, description: 'Professional attire' },
    { id: 'party', label: 'Party', icon: PartyPopper, description: 'Night out looks' },
    { id: 'date', label: 'Date Night', icon: Heart, description: 'Romantic vibes' },
    { id: 'formal', label: 'Formal', icon: Sparkles, description: 'Elegant occasions' },
    { id: 'seasonal', label: 'Trending', icon: TrendingUp, description: 'Latest styles' }
  ];

  const generateRecommendations = async (occasion) => {
    setIsLoading(true);
    setSelectedOccasion(occasion);

    try {
      // Build comprehensive user context
      const wardrobeContext = wardrobeItems.map(item => ({
        name: item.item_name,
        category: item.category,
        colors: item.colors,
        style_tags: item.style_tags
      }));

      const prompt = `You are an expert fashion stylist AI. Create personalized outfit recommendations.

USER PROFILE:
- Gender: ${userProfile?.gender || 'not specified'}
- Body Type: ${userProfile?.body_type || 'not specified'}
- Skin Tone: ${userProfile?.skin_tone || 'not specified'}
- Style Preferences: ${userProfile?.style_preferences?.join(', ') || 'not specified'}
- Favorite Colors: ${userProfile?.favorite_colors?.join(', ') || 'not specified'}
- Budget: ${userProfile?.budget_range || 'mixed'}
- Style DNA: ${userProfile?.style_dna?.primaryStyle || 'not determined'}

WARDROBE (${wardrobeItems.length} items):
${wardrobeContext.length > 0 ? JSON.stringify(wardrobeContext.slice(0, 15)) : 'Empty wardrobe'}

OCCASION: ${occasion}

Generate 3 complete outfit suggestions with:
1. Items from their wardrobe (if available)
2. New items to purchase
3. Styling tips
4. Accessories to complete the look

Consider body type, skin tone, and color harmony.`;

      const result = await base44.integrations.Core.InvokeLLM({
        prompt,
        add_context_from_internet: true,
        response_json_schema: {
          type: "object",
          properties: {
            outfits: {
              type: "array",
              items: {
                type: "object",
                properties: {
                  name: { type: "string" },
                  description: { type: "string" },
                  wardrobe_items: { type: "array", items: { type: "string" } },
                  items_to_buy: { 
                    type: "array", 
                    items: { 
                      type: "object",
                      properties: {
                        item: { type: "string" },
                        category: { type: "string" },
                        color: { type: "string" },
                        priority: { type: "string" }
                      }
                    }
                  },
                  accessories: { type: "array", items: { type: "string" } },
                  styling_tips: { type: "array", items: { type: "string" } },
                  color_palette: { type: "array", items: { type: "string" } },
                  confidence_score: { type: "number" }
                }
              }
            },
            overall_advice: { type: "string" },
            trending_elements: { type: "array", items: { type: "string" } }
          }
        }
      });

      // Match products for recommendations
      const enrichedOutfits = result.outfits?.map(outfit => {
        const matchedProducts = affiliateProducts.filter(product => {
          return outfit.items_to_buy?.some(item => {
            const itemText = `${item.item} ${item.category} ${item.color}`.toLowerCase();
            const productText = `${product.product_name} ${product.category} ${product.color || ''}`.toLowerCase();
            return itemText.split(' ').some(word => word.length > 3 && productText.includes(word));
          });
        });
        return { ...outfit, matchedProducts: matchedProducts.slice(0, 3) };
      });

      setRecommendations({
        ...result,
        outfits: enrichedOutfits,
        occasion
      });
    } catch (error) {
      console.error("Error generating recommendations:", error);
    }

    setIsLoading(false);
  };

  React.useEffect(() => {
    if (userProfile && !recommendations) {
      generateRecommendations('casual');
    }
  }, [userProfile]);

  if (!userProfile) {
    return (
      <Card className="bg-gradient-to-r from-purple-50 to-pink-50">
        <CardContent className="p-8 text-center">
          <Sparkles className="w-12 h-12 mx-auto mb-4 text-purple-400" />
          <h3 className="text-lg font-semibold mb-2">Complete Your Style Profile</h3>
          <p className="text-gray-600 mb-4">
            We need your preferences to generate personalized recommendations
          </p>
          <Button
            onClick={() => navigate(createPageUrl("StyleProfile"))}
            className="bg-gradient-to-r from-purple-500 to-pink-500"
          >
            Complete Profile
          </Button>
        </CardContent>
      </Card>
    );
  }

  return (
    <div className="space-y-6">
      {/* Occasion Selector */}
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Sparkles className="w-5 h-5 text-purple-500" />
            AI Style Recommendations
          </CardTitle>
        </CardHeader>
        <CardContent>
          <p className="text-sm text-gray-600 mb-4">Select an occasion to get personalized outfit suggestions</p>
          <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
            {occasions.map((occ) => {
              const Icon = occ.icon;
              return (
                <button
                  key={occ.id}
                  onClick={() => generateRecommendations(occ.id)}
                  disabled={isLoading}
                  className={`p-4 rounded-xl border-2 transition-all ${
                    selectedOccasion === occ.id
                      ? 'border-purple-500 bg-purple-50'
                      : 'border-gray-200 hover:border-purple-300 hover:bg-purple-50/50'
                  }`}
                >
                  <Icon className={`w-6 h-6 mx-auto mb-2 ${
                    selectedOccasion === occ.id ? 'text-purple-600' : 'text-gray-500'
                  }`} />
                  <p className="text-sm font-medium">{occ.label}</p>
                  <p className="text-xs text-gray-500">{occ.description}</p>
                </button>
              );
            })}
          </div>
        </CardContent>
      </Card>

      {/* Loading State */}
      {isLoading && (
        <Card>
          <CardContent className="p-8 text-center">
            <Loader2 className="w-10 h-10 animate-spin mx-auto text-purple-500 mb-4" />
            <p className="font-medium">Crafting your perfect looks...</p>
            <p className="text-sm text-gray-500">Analyzing your style profile and wardrobe</p>
          </CardContent>
        </Card>
      )}

      {/* Recommendations */}
      <AnimatePresence mode="wait">
        {!isLoading && recommendations && (
          <motion.div
            key={recommendations.occasion}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -20 }}
            className="space-y-6"
          >
            {/* Trending Elements */}
            {recommendations.trending_elements?.length > 0 && (
              <Card className="bg-gradient-to-r from-orange-50 to-pink-50 border-orange-200">
                <CardContent className="p-4">
                  <div className="flex items-center gap-2 mb-2">
                    <TrendingUp className="w-5 h-5 text-orange-500" />
                    <span className="font-medium">Trending Now</span>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {recommendations.trending_elements.map((trend, i) => (
                      <Badge key={i} variant="outline" className="bg-white">
                        {trend}
                      </Badge>
                    ))}
                  </div>
                </CardContent>
              </Card>
            )}

            {/* Outfit Cards */}
            <div className="grid md:grid-cols-3 gap-6">
              {recommendations.outfits?.map((outfit, index) => (
                <motion.div
                  key={index}
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: index * 0.1 }}
                >
                  <Card className="h-full hover:shadow-lg transition-shadow">
                    <CardHeader className="pb-2">
                      <div className="flex items-center justify-between">
                        <CardTitle className="text-lg">{outfit.name}</CardTitle>
                        {outfit.confidence_score && (
                          <Badge className="bg-green-500">
                            {Math.round(outfit.confidence_score)}% match
                          </Badge>
                        )}
                      </div>
                      <p className="text-sm text-gray-600">{outfit.description}</p>
                    </CardHeader>
                    <CardContent className="space-y-4">
                      {/* Color Palette */}
                      {outfit.color_palette?.length > 0 && (
                        <div>
                          <p className="text-xs text-gray-500 mb-2 flex items-center gap-1">
                            <Palette className="w-3 h-3" /> Color Palette
                          </p>
                          <div className="flex gap-1">
                            {outfit.color_palette.map((color, i) => (
                              <div
                                key={i}
                                className="w-8 h-8 rounded-full border shadow-sm"
                                style={{ backgroundColor: color.toLowerCase() }}
                                title={color}
                              />
                            ))}
                          </div>
                        </div>
                      )}

                      {/* From Wardrobe */}
                      {outfit.wardrobe_items?.length > 0 && (
                        <div>
                          <p className="text-xs text-gray-500 mb-2 flex items-center gap-1">
                            <Shirt className="w-3 h-3" /> From Your Wardrobe
                          </p>
                          <div className="space-y-1">
                            {outfit.wardrobe_items.map((item, i) => (
                              <div key={i} className="text-sm bg-green-50 rounded px-2 py-1 text-green-700">
                                ✓ {item}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Items to Buy */}
                      {outfit.items_to_buy?.length > 0 && (
                        <div>
                          <p className="text-xs text-gray-500 mb-2 flex items-center gap-1">
                            <ShoppingBag className="w-3 h-3" /> Recommended Items
                          </p>
                          <div className="space-y-1">
                            {outfit.items_to_buy.map((item, i) => (
                              <div key={i} className="text-sm bg-purple-50 rounded px-2 py-1 text-purple-700">
                                + {item.item}
                                {item.priority === 'high' && (
                                  <Badge className="ml-2 bg-pink-500 text-xs">Must Have</Badge>
                                )}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Accessories */}
                      {outfit.accessories?.length > 0 && (
                        <div>
                          <p className="text-xs text-gray-500 mb-1">Accessories</p>
                          <div className="flex flex-wrap gap-1">
                            {outfit.accessories.map((acc, i) => (
                              <Badge key={i} variant="outline" className="text-xs">
                                {acc}
                              </Badge>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Styling Tips */}
                      {outfit.styling_tips?.length > 0 && (
                        <div className="bg-gray-50 rounded-lg p-3">
                          <p className="text-xs text-gray-500 mb-1">Pro Tips</p>
                          {outfit.styling_tips.map((tip, i) => (
                            <p key={i} className="text-xs text-gray-600">• {tip}</p>
                          ))}
                        </div>
                      )}

                      {/* Matched Products */}
                      {outfit.matchedProducts?.length > 0 && (
                        <div>
                          <p className="text-xs text-gray-500 mb-2">Shop This Look</p>
                          <div className="flex gap-2 overflow-x-auto pb-2">
                            {outfit.matchedProducts.map((product) => (
                              <a
                                key={product.id}
                                href={product.product_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="flex-shrink-0 w-20"
                              >
                                <div className="aspect-square bg-gray-100 rounded-lg overflow-hidden mb-1">
                                  {product.image_url ? (
                                    <img
                                      src={product.image_url}
                                      alt={product.product_name}
                                      className="w-full h-full object-cover"
                                    />
                                  ) : (
                                    <div className="w-full h-full flex items-center justify-center">
                                      <ShoppingBag className="w-6 h-6 text-gray-300" />
                                    </div>
                                  )}
                                </div>
                                <p className="text-xs line-clamp-1">{product.product_name}</p>
                                <p className="text-xs font-semibold text-purple-600">₹{product.price}</p>
                              </a>
                            ))}
                          </div>
                        </div>
                      )}
                    </CardContent>
                  </Card>
                </motion.div>
              ))}
            </div>

            {/* Overall Advice */}
            {recommendations.overall_advice && (
              <Card className="bg-gradient-to-r from-blue-50 to-purple-50">
                <CardContent className="p-4">
                  <div className="flex items-start gap-3">
                    <Sparkles className="w-5 h-5 text-purple-600 mt-1" />
                    <div>
                      <p className="font-medium mb-1">Stylist's Note</p>
                      <p className="text-sm text-gray-700">{recommendations.overall_advice}</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            )}

            <div className="text-center">
              <Button
                onClick={() => generateRecommendations(selectedOccasion)}
                variant="outline"
                disabled={isLoading}
              >
                <RefreshCw className="w-4 h-4 mr-2" />
                Refresh Recommendations
              </Button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
